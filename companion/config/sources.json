{
  "version": 2,
  "root": [
    {
      "id": "live",
      "name": "Live",
      "node_type": "category",
      "children": [
        {
          "id": "browser",
          "name": "Browser",
          "node_type": "source",
          "playback": {
            "type": "live",
            "port": 8000,
            "path": "/live/stream.m3u8"
          },
          "runner": {
            "type": "powershell",
            "script": "scripts/start_browser.ps1"
          },
          "health": {
            "type": "hls_local",
            "min_segments": 2,
            "first_attempt_timeout_seconds": 15,
            "second_attempt_timeout_seconds": 30,
            "max_attempts": 2
          }
        }
      ]
    },
    {
      "id": "camera",
      "name": "Camera",
      "node_type": "category",
      "children": [
        {
          "id": "pc_camera",
          "name": "PC Camera",
          "node_type": "source",
          "playback": {
            "type": "live",
            "port": 8000,
            "path": "/live/stream.m3u8"
          },
          "runner": {
            "type": "powershell",
            "script": "scripts/start_camera.ps1"
          },
          "health": {
            "type": "hls_local",
            "min_segments": 2,
            "first_attempt_timeout_seconds": 15,
            "second_attempt_timeout_seconds": 30,
            "max_attempts": 2
          }
        }
      ]
    },
    {
      "id": "vod",
      "name": "VOD",
      "node_type": "category",
      "dynamic": {
        "type": "media_directory",
        "path": "vod",
        "extensions": [
          ".mp4",
          ".m4v",
          ".mkv",
          ".webm",
          ".mov",
          ".ts",
          ".m2ts"
        ]
      }
    }
  ]
}