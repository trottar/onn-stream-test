<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:background="#000000">


    <!-- Top control bar -->

    <LinearLayout

        android:id="@+id/top_control_bar"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal"

        android:gravity="center_vertical"

        android:background="#0E0E0E"

        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">


        <Button

            android:id="@+id/button_back"

            android:layout_width="104dp"
            android:layout_height="50dp"

            android:layout_marginEnd="10dp"

            android:text="BACK"

            android:textSize="15sp"
            android:textStyle="bold"

            android:textColor="@color/mode_button_text"

            android:background="@drawable/mode_button_background"

            android:focusable="true" />


        <TextView

            android:id="@+id/breadcrumb_text"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:text="PrivyHub"

            android:textColor="#FFFFFF"

            android:textSize="18sp"

            android:textStyle="bold"

            android:singleLine="true"
            android:ellipsize="end"

            android:paddingStart="12dp"
            android:paddingEnd="12dp" />


        <Button

            android:id="@+id/button_refresh"

            android:layout_width="112dp"
            android:layout_height="50dp"

            android:layout_marginEnd="10dp"

            android:text="REFRESH"

            android:textSize="14sp"
            android:textStyle="bold"

            android:textColor="@color/mode_button_text"

            android:background="@drawable/mode_button_background"

            android:focusable="true" />


        <Button

            android:id="@+id/button_settings"

            android:layout_width="122dp"
            android:layout_height="50dp"

            android:layout_marginEnd="10dp"

            android:text="SETTINGS"

            android:textSize="14sp"
            android:textStyle="bold"

            android:textColor="@color/mode_button_text"

            android:background="@drawable/mode_button_background"

            android:focusable="true" />


        <Button

            android:id="@+id/button_stop"

            android:layout_width="104dp"
            android:layout_height="50dp"

            android:text="STOP"

            android:textSize="15sp"
            android:textStyle="bold"

            android:textColor="@color/mode_button_text"

            android:background="@drawable/mode_button_background"

            android:focusable="true" />


    </LinearLayout>


    <!-- Connection / source status -->

    <TextView

        android:id="@+id/status_text"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="Loading..."

        android:textColor="#D0D0D0"

        android:textSize="14sp"

        android:singleLine="true"
        android:ellipsize="end"

        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp" />


    <!-- Persistent Now Playing bar -->

    <LinearLayout

        android:id="@+id/now_playing_bar"

        android:layout_width="match_parent"
        android:layout_height="116dp"

        android:orientation="horizontal"

        android:gravity="center_vertical"

        android:background="#171717"

        android:paddingStart="24dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"

        android:visibility="gone">


        <LinearLayout

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:orientation="vertical"

            android:gravity="center_vertical">


            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="NOW PLAYING"

                android:textColor="#8A8A8A"

                android:textSize="11sp"

                android:textStyle="bold" />


            <TextView

                android:id="@+id/now_playing_title"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Nothing playing"

                android:textColor="#FFFFFF"

                android:textSize="17sp"

                android:textStyle="bold"

                android:singleLine="true"

                android:ellipsize="end" />


        </LinearLayout>


        <TextView

            android:id="@+id/now_playing_progress"

            android:layout_width="150dp"
            android:layout_height="wrap_content"

            android:gravity="center"

            android:text=""

            android:textColor="#D0D0D0"

            android:textSize="15sp" />


        <FrameLayout

            android:id="@+id/now_playing_preview_host"

            android:layout_width="184dp"
            android:layout_height="104dp"

            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"

            android:background="#000000">


            <androidx.media3.ui.PlayerView

                android:id="@+id/player_view"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:keepScreenOn="true"

                android:background="#000000"

                android:clickable="true"
                android:focusable="true"

                app:show_buffering="when_playing"

                app:use_controller="false" />


        </FrameLayout>


        <Button

            android:id="@+id/button_restart"

            android:layout_width="125dp"
            android:layout_height="52dp"

            android:text="RESTART"

            android:textSize="13sp"
            android:textStyle="bold"

            android:textColor="@color/mode_button_text"

            android:background="@drawable/mode_button_background"

            android:focusable="true" />


    </LinearLayout>


    <!-- Dynamic nested source page -->

    <ScrollView

        android:id="@+id/source_scroll"

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:fillViewport="true"

        android:clipToPadding="false"
        android:overScrollMode="never"

        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">


        <GridLayout

            android:id="@+id/source_grid"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:columnCount="3"

            android:alignmentMode="alignMargins"

            android:useDefaultMargins="false" />


    </ScrollView>


    <!-- Fullscreen host. The same PlayerView is moved here on demand. -->

    <FrameLayout

        android:id="@+id/fullscreen_player_host"

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:background="#000000"

        android:visibility="gone" />


</LinearLayout>
