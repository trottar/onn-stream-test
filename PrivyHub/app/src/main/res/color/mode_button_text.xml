<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SELECTED / ACTIVE -->
    <item
        android:state_selected="true"
        android:color="#000000" />


    <!-- FOCUSED / REMOTE HIGHLIGHT -->
