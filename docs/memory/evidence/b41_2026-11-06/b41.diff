@@ -0,0 +1,182 @@
+package com.safeiot.privyhub.streaming
+
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * B41: the player prompt, behind the system property `debug.privyhub.player_prompt=1` (CL-B7P's convention).
+ * Absent / empty / any other value = today: no object, no view, no query or report key.
+ *
+ * On top of B34 / B38's stable slots (the prompt implies them): at a game's start and when a new eligible pad
+ * appears, "Player N — press any button" bottom-centre; the first unclaimed eligible pad to press a face button or
+ * Start claims the lowest open slot below the title's player count (the host's `players`, 2 when absent) and shows
+ * "PN" for 2 s; the press also reaches the game (never blocking input). A pad already in the map keeps its slot and
+ * shows its badge on its first press. Select + Start held 2 s releases a slot ("PN released"). A 1-player title:
+ * no prompt, B34's assignment. Design: `docs/memory/evidence/b41_2026-11-06/design_written_before_code.md`
+ * (hashed before this code).
+ */
+object PlayerPromptFlag {
+    const val PROPERTY = "debug.privyhub.player_prompt"
+
+    fun parse(value: String?): Boolean = value?.trim() == "1"
+
+    /** The property, read through reflection; a failed read is absent (today). */
+    fun fromSystem(): Boolean =
+        try {
+            val get = Class.forName("android.os.SystemProperties").getMethod("get", String::class.java)
+            parse(get.invoke(null, PROPERTY) as? String)
+        } catch (_: Throwable) {
+            false
+        }
+}
+
+class PlayerPrompt(private val slots: PadSlots) {
+    data class View(val prompt: String?, val badge: String?)
+
+    @Volatile
+    var players: Int = DEFAULT_PLAYERS
+        private set
+
+    private val lock = Any()
+    private val claimedBy = HashMap<Int, String>()      // slot -> prompt | stable
+    private val badgeShown = HashSet<String>()           // pad keys badged this session
+    private val holdBits = HashMap<String, Int>()        // pad key -> Select (1) / Start (2) held
+    private val holdSince = HashMap<String, Long>()      // pad key -> both held since
+    private var badgeText: String? = null
+    private var badgeUntilMs = 0L
+
+    val active: Boolean get() = players >= 2
+
+    /** The sender's start, in place of [PadSlots.beginStart]: no pre-assignment; the map's pads keep their slots. */
+    fun beginStart(connected: List<PadDevice>) {
+        synchronized(lock) {
+            badgeShown.clear()
+            holdBits.clear()
+            holdSince.clear()
+            badgeText = null
+            if (!active) slots.beginStart(connected)
+            markStable()
+        }
+    }
+
+    /** After the start response: the title's player count; 1 = B34's assignment, no prompt. */
+    fun setPlayers(n: Int, connected: List<PadDevice>) {
+        synchronized(lock) {
+            players = n.coerceIn(1, 4)
+            if (!active) {
+                slots.beginStart(connected)
+                markStable()
+            }
+        }
+    }
+
+    /** A key event's slot: null = no player (an unclaimed pad's non-claim key, or not a gamepad). */
+    fun slotForKey(d: PadDevice, keyCode: Int, down: Boolean, nowMs: Long, connected: () -> List<PadDevice>): Int? {
+        if (!active) return slots.slotFor(d, connected)
+        if (!PadSlots.eligible(d)) return null
+        val k = PadSlots.key(d)
+        synchronized(lock) {
+            slots.slotOfKey(k)?.let { s ->
+                trackHold(k, keyCode, down, nowMs)
+                if (down && badgeShown.add(k)) badge("P${s + 1}", nowMs)
+                return s
+            }
+            if (!down || keyCode !in CLAIM_KEYS) return null
+            val s = openSlot(connected())?.also { slots.claim(d, it) }
+                ?: slots.slotFor(d, connected)
+                ?: return null
+            claimedBy[s] = PROMPT
+            holdBits.remove(k)
+            badgeShown.add(k)
+            badge("P${s + 1}", nowMs)
+            return s
+        }
+    }
+
+    /** A motion event's slot: a stick never claims. */
+    fun slotForMotion(d: PadDevice, connected: () -> List<PadDevice>): Int? =
+        if (!active) slots.slotFor(d, connected) else slots.slotOf(d)
+
+    /** The UI tick: a Select + Start hold of [RELEASE_MS] frees the pad's slot. */
+    fun tick(nowMs: Long) {
+        synchronized(lock) {
+            val due = holdSince.filter { nowMs - it.value >= RELEASE_MS }.keys.toList()
+            for (k in due) {
+                holdSince.remove(k)
+                holdBits.remove(k)
+                val s = slots.slotOfKey(k) ?: continue
+                slots.release(s)
+                claimedBy.remove(s)
+                badgeShown.remove(k)
+                badge("P${s + 1} released", nowMs)
+            }
+        }
+    }
+
+    fun view(nowMs: Long, connected: List<PadDevice>): View = synchronized(lock) {
+        val prompt = if (!active) null else {
+            val unclaimed = connected.any { PadSlots.eligible(it) && slots.slotOf(it) == null }
+            openSlot(connected)?.takeIf { unclaimed }?.let { "Player ${it + 1} — press any button" }
+        }
+        View(prompt, badgeText?.takeIf { nowMs < badgeUntilMs })
+    }
+
+    /** `slot:p|s` for each claimed or kept slot (the start's and the heartbeat's `pad_claims`). */
+    fun claimsString(): String = synchronized(lock) {
+        claimedBy.entries.sortedBy { it.key }.joinToString(",") { "${it.key}:${if (it.value == PROMPT) "p" else "s"}" }
+    }
+
+    fun claimsJson(): JSONArray = synchronized(lock) {
+        JSONArray().apply {
+            claimedBy.entries.sortedBy { it.key }.forEach { put(JSONObject().put("slot", it.key).put("claimed_by", it.value)) }
+        }
+    }
+
+    fun claimedBy(slot: Int): String? = synchronized(lock) { claimedBy[slot] }
+
+    /** The lowest slot below [players] with no holder, or whose holder is not connected. */
+    private fun openSlot(connected: List<PadDevice>): Int? {
+        val present = connected.filter { PadSlots.eligible(it) }.map { PadSlots.key(it) }.toSet()
+        return (0 until players).firstOrNull { s -> slots.holderOf(s)?.let { it !in present } ?: true }
+    }
+
+    private fun markStable() {
+        claimedBy.clear()
+        slots.map().forEach { claimedBy[it.slot] = STABLE }
+    }
+
+    private fun trackHold(k: String, keyCode: Int, down: Boolean, nowMs: Long) {
+        val bit = when (keyCode) {
+            KEYCODE_BUTTON_SELECT -> 1
+            KEYCODE_BUTTON_START -> 2
+            else -> return
+        }
+        val bits = (holdBits[k] ?: 0).let { if (down) it or bit else it and bit.inv() }
+        holdBits[k] = bits
+        if (bits == 3) holdSince.putIfAbsent(k, nowMs) else holdSince.remove(k)
+    }
+
+    private fun badge(text: String, nowMs: Long) {
+        badgeText = text
+        badgeUntilMs = nowMs + BADGE_MS
+    }
+
+    companion object {
+        const val DEFAULT_PLAYERS = 2
+        const val BADGE_MS = 2_000L
+        const val RELEASE_MS = 2_000L
+        const val PROMPT = "prompt"
+        const val STABLE = "stable"
+
+        // android.view.KeyEvent's codes, inlined so the JVM tests need no Android stub
+        const val KEYCODE_BUTTON_A = 96
+        const val KEYCODE_BUTTON_B = 97
+        const val KEYCODE_BUTTON_X = 99
+        const val KEYCODE_BUTTON_Y = 100
+        const val KEYCODE_BUTTON_START = 108
+        const val KEYCODE_BUTTON_SELECT = 109
+
+        /** A face button or Start claims a slot. */
+        val CLAIM_KEYS = setOf(KEYCODE_BUTTON_A, KEYCODE_BUTTON_B, KEYCODE_BUTTON_X, KEYCODE_BUTTON_Y, KEYCODE_BUTTON_START)
+    }
+}
diff --git a/PrivyHub/app/src/test/java/streaming/PlayerPromptTest.kt b/PrivyHub/app/src/test/java/streaming/PlayerPromptTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..bd015bd1d25daa9ebf07ea4b5087622b232b2b09
--- /dev/null
+++ b/PrivyHub/app/src/test/java/streaming/PlayerPromptTest.kt
@@ -0,0 +1,193 @@
+package com.safeiot.privyhub.streaming
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * B41: the player prompt over the stable slots (debug.privyhub.player_prompt=1). Fake devices as B38's test: the onn's
+ * virtual remote (C4), two real pads with controller numbers 2 and 3.
+ */
+class PlayerPromptTest {
+
+    private data class Dev(
+        override val descriptor: String,
+        override val controllerNumber: Int,
+        override val vendorId: Int,
+        override val productId: Int,
+        override val sources: Int,
+        override val hasGamepadButton: Boolean,
+        override val isVirtual: Boolean,
+        override val hasFaceButton: Boolean,
+        override val hasStickOrHat: Boolean,
+    ) : PadDevice
+
+    companion object {
+        const val GAMEPAD = 0x00000401
+        const val JOYSTICK = 0x01000010
+        const val KEYBOARD = 0x00000101
+        const val DPAD = 0x00000201
+        const val A = PlayerPrompt.KEYCODE_BUTTON_A
+        const val X = PlayerPrompt.KEYCODE_BUTTON_X
+        const val START = PlayerPrompt.KEYCODE_BUTTON_START
+        const val SELECT = PlayerPrompt.KEYCODE_BUTTON_SELECT
+        const val L1 = 102
+    }
+
+    private val virtualRemote = Dev("virtual-remote-desc", 1, 0x18d1, 0x0001, KEYBOARD or DPAD or GAMEPAD,
+        hasGamepadButton = true, isVirtual = false, hasFaceButton = true, hasStickOrHat = false)
+    private val padA = Dev("pad-a-desc", 2, 0x054c, 0x09cc, GAMEPAD or JOYSTICK or KEYBOARD,
+        hasGamepadButton = true, isVirtual = false, hasFaceButton = true, hasStickOrHat = true)
+    private val padB = Dev("pad-b-desc", 3, 0x054c, 0x09cc, GAMEPAD or JOYSTICK or KEYBOARD,
+        hasGamepadButton = true, isVirtual = false, hasFaceButton = true, hasStickOrHat = true)
+    private val onn = listOf(virtualRemote, padA, padB)
+    private val conn = { onn }
+
+    private fun fresh(players: Int = 2): Pair<PadSlots, PlayerPrompt> {
+        val s = PadSlots()
+        val p = PlayerPrompt(s)
+        p.beginStart(onn)
+        p.setPlayers(players, onn)
+        return s to p
+    }
+
+    private fun press(p: PlayerPrompt, d: PadDevice, key: Int, now: Long): Int? {
+        val slot = p.slotForKey(d, key, true, now, conn)
+        p.slotForKey(d, key, false, now + 50, conn)
+        return slot
+    }
+
+    @Test
+    fun padBPressesFirstAndIsPlayerOneThenPadAIsPlayerTwo() {
+        val (s, p) = fresh()
+        assertEquals("Player 1 — press any button", p.view(0, onn).prompt)
+        assertTrue(s.map().isEmpty())                       // no pre-assignment by controller number
+        assertEquals(0, press(p, padB, A, 100))
+        assertEquals("P1", p.view(200, onn).badge)
+        assertEquals("Player 2 — press any button", p.view(200, onn).prompt)
+        assertEquals(1, press(p, padA, START, 300))
+        assertEquals("P2", p.view(400, onn).badge)
+        assertNull(p.view(400, onn).prompt)                 // up to the title's count, then gone
+        assertNull(p.view(2_400, onn).badge)                // the badge for 2 s
+        assertEquals(0, s.slotOf(padB)); assertEquals(1, s.slotOf(padA))
+        assertEquals("0:p,1:p", p.claimsString())
+        assertEquals(0, p.slotForKey(padB, L1, true, 500, conn))  // claimed: every key goes to its slot
+    }
+
+    @Test
+    fun aOnePlayerTitleShowsNoPromptAndKeepsB34sAssignment() {
+        val (s, p) = fresh(players = 1)
+        assertFalse(p.active)
+        assertNull(p.view(0, onn).prompt)
+        assertEquals(0, s.slotOf(padA)); assertEquals(1, s.slotOf(padB))   // B34: controller-number order
+        assertEquals(1, press(p, padB, A, 100))
+        assertNull(p.view(200, onn).badge)
+        assertEquals("0:s,1:s", p.claimsString())
+    }
+
+    @Test
+    fun selectStartHeldTwoSecondsReleasesAndAnotherPadReclaims() {
+        val (s, p) = fresh()
+        press(p, padA, A, 0); press(p, padB, A, 100)
+        assertEquals(0, s.slotOf(padA))
+        p.slotForKey(padA, SELECT, true, 1_000, conn)
+        p.slotForKey(padA, START, true, 1_050, conn)
+        p.tick(2_000); assertEquals(0, s.slotOf(padA))       // under 2 s: nothing
+        p.tick(3_060)
+        assertNull(s.slotOf(padA))
+        assertEquals("P1 released", p.view(3_100, onn).badge)
+        assertEquals("Player 1 — press any button", p.view(3_100, onn).prompt)
+        p.slotForKey(padA, SELECT, false, 3_200, conn)
+        p.slotForKey(padA, START, false, 3_210, conn)
+        // swap: B releases too, then A presses first and is P1
+        p.slotForKey(padB, SELECT, true, 4_000, conn); p.slotForKey(padB, START, true, 4_000, conn)
+        p.tick(6_100)
+        assertNull(s.slotOf(padB))
+        p.slotForKey(padB, SELECT, false, 6_200, conn); p.slotForKey(padB, START, false, 6_200, conn)
+        assertEquals(0, press(p, padA, X, 7_000))
+        assertEquals(1, press(p, padB, A, 7_100))
+        assertEquals("0:p,1:p", p.claimsString())
+    }
+
+    @Test
+    fun aShortHoldReleasesNothing() {
+        val (s, p) = fresh()
+        press(p, padA, A, 0)
+        p.slotForKey(padA, SELECT, true, 1_000, conn); p.slotForKey(padA, START, true, 1_000, conn)
+        p.tick(2_400)                                         // 1.4 s held: not yet
+        assertEquals(0, s.slotOf(padA))
+        p.slotForKey(padA, START, false, 2_500, conn)
+        p.tick(4_000)
+        assertEquals(0, s.slotOf(padA))
+    }
+
+    @Test
+    fun aPadAlreadyInTheMapKeepsItsSlotAndShowsItsBadgeOnItsFirstPress() {
+        val s = PadSlots()
+        val p = PlayerPrompt(s)
+        p.beginStart(onn); p.setPlayers(2, onn)
+        press(p, padB, A, 0); press(p, padA, A, 10)
+        // a second start in the same process (a relaunch or a self-restart)
+        p.beginStart(onn); p.setPlayers(2, onn)
+        assertEquals("0:s,1:s", p.claimsString())
+        assertNull(p.view(100, onn).prompt)                  // both pads hold slots: nothing to ask
+        assertNull(p.view(100, onn).badge)
+        assertEquals(1, p.slotForKey(padA, L1, true, 200, conn))
+        assertEquals("P2", p.view(300, onn).badge)          // its badge on its first press
+    }
+
+    @Test
+    fun aStickNeverClaimsAndANonClaimKeyIsDropped() {
+        val (s, p) = fresh()
+        assertNull(p.slotForMotion(padA, conn))
+        assertNull(p.slotForKey(padA, L1, true, 0, conn))
+        assertTrue(s.map().isEmpty())
+        press(p, padA, A, 100)
+        assertEquals(0, p.slotForMotion(padA, conn))
+    }
+
+    @Test
+    fun theVirtualRemoteNeverClaims() {
+        val (s, p) = fresh()
+        assertNull(press(p, virtualRemote, A, 0))
+        assertNull(press(p, virtualRemote, START, 10))
+        assertTrue(s.map().isEmpty())
+        assertNull(p.view(100, listOf(virtualRemote)).prompt)  // no eligible pad: no prompt
+    }
+
+    @Test
+    fun aThirdPadOnATwoPlayerTitleStillGetsAPlayerAsB34Would() {
+        val padC = padA.copy(descriptor = "pad-c-desc", controllerNumber = 4)
+        val all = onn + padC
+        val s = PadSlots(); val p = PlayerPrompt(s)
+        p.beginStart(all); p.setPlayers(2, all)
+        assertEquals(0, p.slotForKey(padA, A, true, 0, { all }))
+        assertEquals(1, p.slotForKey(padB, A, true, 10, { all }))
+        assertNull(p.view(20, all).prompt)                   // the count reached: no prompt for the third
+        assertEquals(2, p.slotForKey(padC, A, true, 30, { all }))
+        assertEquals("P3", p.view(40, all).badge)
+    }
+
+    @Test
+    fun theFlagIsOptIn() {
+        assertFalse(PlayerPromptFlag.parse(null))
+        assertFalse(PlayerPromptFlag.parse(""))
+        assertFalse(PlayerPromptFlag.parse("0"))
+        assertFalse(PlayerPromptFlag.parse("true"))
+        assertFalse(PlayerPromptFlag.parse("yes"))
+        assertTrue(PlayerPromptFlag.parse("1"))
+        assertTrue(PlayerPromptFlag.parse(" 1 "))
+        assertFalse(PlayerPromptFlag.fromSystem())           // no Android on the JVM: absent
+    }
+
+    @Test
+    fun absentThePadSlotsAloneAreB34AndB38sAsBuilt() {
+        // with no prompt the sender's path is PadSlots alone: the start pre-assigns by controller number
+        val s = PadSlots()
+        s.beginStart(onn)
+        assertEquals(0, s.slotFor(padA) { onn }); assertEquals(1, s.slotFor(padB) { onn })
+        assertNull(s.slotFor(virtualRemote) { onn })
+    }
+}
diff --git a/tests/player_prompt/test_player_prompt.py b/tests/player_prompt/test_player_prompt.py
new file mode 100644
index 0000000000000000000000000000000000000000..0a7e7c60b99b587a4e03c52ea1e86f5350a57be8
--- /dev/null
+++ b/tests/player_prompt/test_player_prompt.py
@@ -0,0 +1,171 @@
+#!/usr/bin/env python3
+"""B41 (host): the title's player count in the start response for a client with `player_prompt=1`, and the prompt's
+claims (`claimed_by`) on the `pad_slots` rows; no key = today (nothing imported, the response and rows byte for byte).
+
+    python3 -m unittest discover -s tests/player_prompt -v
+
+`plugins/games.py` loaded alone (tests/pad_slots' way), a real LinkDropRecovery on a temp dir, a fake emulator.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import subprocess
+import sys
+import tempfile
+import types
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "companion"))
+
+from games import link_drop_recovery as ldr  # noqa: E402
+import player_count  # noqa: E402
+import pad_slots  # noqa: E402
+
+spec = importlib.util.spec_from_file_location("b41_games_plugin", ROOT / "companion" / "plugins" / "games.py")
+G = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(G)
+
+TWO = "0:a1b2c3:sony,1:d4e5f6:sony"
+HB = "sequence={}&interval_ms=2000&last_output_age_ms=16&rendered_frames=600&queued_frames=0&rx_packets=900&elapsed_ms=10000"
+
+
+def plugin(system="ps1", player_mode="unknown", source="unknown", max_players=0, multitap=False, game=True):
+    root = Path(tempfile.mkdtemp(prefix="b41_root_"))
+    rec = ldr.LinkDropRecovery(
+        root, pause_game=lambda: None, resume_game=lambda: None, save_recovery_state=lambda: {},
+        restart_encoder=lambda: {}, full_start_encoder=lambda: {}, stream_active=lambda: True,
+        end_session=lambda: None, client_packet_age_ms=lambda: 10.0, recovery_save_detail=lambda: {})
+
+    class Emu:
+        active_game = {"id": "g1", "system": system, "title": "t"} if game else None
+
+        def status(self):
+            return {"active": True, "paused": True, "pid": 1}
+
+        def ps1_multitap(self, g):
+            return {"enabled": multitap, "mode": "port1" if multitap else "off"}
+
+    class Ctl:
+        def status(self):
+            return {"updates_by_player": [1, 0, 0, 0]}
+
+    p = object.__new__(G.GamesPlugin)
+    p.PROJECT_ROOT = root
+    p._emulator = Emu()
+    p._recovery = rec
+    p._native_stream = types.SimpleNamespace(start=lambda **kw: {"active": True},
+                                             _session_io=types.SimpleNamespace(controller=Ctl()))
+    p._diagnostic_heartbeat_interval_ms = lambda: 2000
+    p._adaptive_bitrate_session_ended = lambda: None
+    p._read_library_state = lambda: {"games": {}}
+    p._decorate_game = lambda g, lib, st, md: {**g, "player_mode": player_mode, "player_mode_source": source,
+                                               "max_players": max_players}
+    return p, root, rec
+
+
+def rec_rows(rec):
+    path = rec.log_path()
+    return [json.loads(x) for x in path.read_text().splitlines()] if path.exists() else []
+
+
+def hb_rows(root):
+    path = root / "logs" / "games" / "native_stream_heartbeat.log"
+    return [json.loads(x) for x in path.read_text().splitlines()] if path.exists() else []
+
+
+class Players(unittest.TestCase):
+    def start(self, **kw):
+        p, root, rec = plugin(**kw)
+        return p.handle_post_request("native-stream-start", "port=48100&player_prompt=1", "127.0.0.1")
+
+    def test_an_unknown_title_is_two(self):
+        r = self.start()
+        self.assertEqual((r["players"], r["players_source"]), (2, "default"))
+
+    def test_single_is_one(self):
+        self.assertEqual(self.start(player_mode="single", source="manual", max_players=4)["players"], 1)
+        self.assertEqual(self.start(player_mode="single", source="metadata", max_players=1)["players_source"],
+                         "metadata")
+
+    def test_ps1_with_the_multitap_is_four_and_without_it_two(self):
+        self.assertEqual(self.start(player_mode="multi", source="metadata", max_players=4, multitap=True)["players"], 4)
+        self.assertEqual(self.start(player_mode="multi", source="metadata", max_players=4, multitap=False)["players"], 2)
+        self.assertEqual(self.start(multitap=True)["players"], 4)                       # unknown + multitap: the ports
+        self.assertEqual(self.start(player_mode="multi", max_players=3, multitap=True)["players"], 3)
+
+    def test_a_four_player_snes_title_is_two(self):
+        r = self.start(system="snes", player_mode="multi", source="metadata", max_players=4, multitap=True)
+        self.assertEqual((r["players"], r["players_source"]), (2, "metadata"))
+
+    def test_no_game_or_a_failing_read_is_two(self):
+        self.assertEqual(self.start(game=False)["players"], 2)
+        p, root, rec = plugin()
+        p._decorate_game = lambda *a: (_ for _ in ()).throw(RuntimeError("x"))
+        r = p.handle_post_request("native-stream-start", "port=48100&player_prompt=1", "127.0.0.1")
+        self.assertEqual((r["players"], r["players_source"]), (2, "default"))
+
+    def test_without_the_key_the_response_is_todays(self):
+        p, root, rec = plugin(player_mode="single")
+        r = p.handle_post_request("native-stream-start", "port=48100", "127.0.0.1")
+        self.assertNotIn("players", r)
+        self.assertNotIn("players_source", r)
+        r2 = p.handle_post_request("native-stream-start", "port=48100&player_prompt=0", "127.0.0.1")
+        self.assertNotIn("players", r2)
+
+
+class Claims(unittest.TestCase):
+    def test_the_claims_ride_the_start_and_heartbeat_rows(self):
+        p, root, rec = plugin()
+        p.handle_post_request("native-stream-start", "port=48100&player_prompt=1&pad_slots=" + TWO + "&pad_claims=0:p,1:s",
+                              "127.0.0.1")
+        p.handle_post_request("native-stream-heartbeat", HB.format(1) + "&pad_slots=" + TWO + "&pad_claims=0:p,1:s",
+                              "127.0.0.1")
+        p.handle_post_request("native-stream-heartbeat", HB.format(2) + "&pad_slots=" + TWO + "&pad_claims=0:p,1:p",
+                              "127.0.0.1")
+        rows = [r for r in rec_rows(rec) if r["event"] == "pad_slots"]
+        self.assertEqual(rows[0]["when"], "start")
+        self.assertEqual([e["claimed_by"] for e in rows[0]["slots"]], ["prompt", "stable"])
+        self.assertEqual([r["when"] for r in rows], ["start", "change"])   # a re-claim is a change
+        self.assertEqual([e["claimed_by"] for e in rows[1]["slots"]], ["prompt", "prompt"])
+        self.assertEqual([e["claimed_by"] for e in hb_rows(root)[0]["pad_slots"]], ["prompt", "stable"])
+
+    def test_without_claims_the_rows_are_b34s(self):
+        log = pad_slots.SlotsLog()
+        rows = []
+        fake = types.SimpleNamespace(_log=lambda ev, **f: rows.append({"event": ev, **f}))
+        log.start(fake, TWO)
+        log2 = pad_slots.SlotsLog()
+        rows2 = []
+        log2.start(types.SimpleNamespace(_log=lambda ev, **f: rows2.append({"event": ev, **f})), TWO, claims=None)
+        self.assertEqual(rows, rows2)
+        self.assertNotIn("claimed_by", json.dumps(rows))
+
+    def test_a_malformed_claims_value_adds_nothing(self):
+        for bad in ("0:x", "9:p", "0:p;1:s", "0:prompt"):
+            self.assertIsNone(pad_slots.parse_claims(bad))
+            self.assertEqual(pad_slots.with_claims(pad_slots.parse(TWO), bad), pad_slots.parse(TWO))
+        self.assertEqual(pad_slots.parse_claims(""), {})
+
+    def test_the_rule_alone(self):
+        self.assertEqual(player_count.rule("", "", 0, False), (2, "default"))
+        self.assertEqual(player_count.rule("multi", "manual", 0, False), (2, "manual"))
+        self.assertEqual(player_count.rule("multi", "metadata", 2, True), (2, "multitap"))
+
+
+class Absent(unittest.TestCase):
+    def test_a_fresh_process_without_the_key_imports_nothing(self):
+        code = ("import sys, importlib.util; sys.path.insert(0, 'companion');"
+                "s = importlib.util.spec_from_file_location('g', 'companion/plugins/games.py');"
+                "m = importlib.util.module_from_spec(s); s.loader.exec_module(m);"
+                "print('player_count' in sys.modules, 'pad_slots' in sys.modules)")
+        out = subprocess.run([sys.executable, "-c", code], cwd=ROOT, capture_output=True, text=True,
+                             env={"PATH": "/usr/bin:/bin"})
+        self.assertEqual(out.stdout.strip(), "False False", out.stderr[-500:])
+
+
+if __name__ == "__main__":
+    unittest.main()
