+    return {"retroarch_fps": ra.get("frames_per_s"), "retroarch_titles": ra.get("titles"),
+            "capture_fps": cap, "dupdrop_per_min": dd,
+            "clauses": "retroarch_fps >= 59.9; capture_fps 60 +/- 0.1; dupdrop_per_min <= 0.2 (E4-S4 / E4-S5)"}
+
