diff --git a/PrivyHub/app/src/main/java/streaming/OpusDecodePipeline.kt b/PrivyHub/app/src/main/java/streaming/OpusDecodePipeline.kt
new file mode 100644
index 0000000..3001c57
--- /dev/null
+++ b/PrivyHub/app/src/main/java/streaming/OpusDecodePipeline.kt
@@ -0,0 +1,186 @@
+package com.safeiot.privyhub.streaming
+
+import java.util.concurrent.ArrayBlockingQueue
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicLong
+
+/**
+ * CL-B5: the Opus decode off the audio receive thread. CL-B4 decoded
+ * synchronously on it (3.3 ms per frame on average, 84 ms at most), so the
+ * socket was not read while the codec worked; the likely cause of its 40
+ * underruns.
+ *
+ * The receive thread offers what [OpusReorder] releases, in order, to a
+ * bounded queue and never waits: a full queue drops the item and counts it.
+ * One decode thread takes the items in that order, owns the decoder (made on
+ * its first frame, released at its end) and feeds the [Sink] — for an Opus
+ * session it is the PCM queue's only producer. Pure Kotlin: the decoder and
+ * the sink are injected, so the JVM tests drive it.
+ */
+class OpusDecodePipeline(
+    private val decoderFactory: (Int) -> FrameDecoder,
+    private val sink: Sink,
+    capacity: Int = DEFAULT_CAPACITY,
+    private val clock: () -> Long = System::nanoTime,
+) {
+    companion object {
+        const val DEFAULT_CAPACITY = 64          // ~640 ms of 10-ms frames
+        private const val POLL_MS = 200L
+        private const val JOIN_MS = 1000L
+    }
+
+    interface FrameDecoder {
+        val name: String
+
+        /** Decode one packet; [out] gets each PCM output (bytes, length). False if it was not decoded. */
+        fun decode(packet: ByteArray, out: (ByteArray, Int) -> Unit): Boolean
+
+        fun release()
+    }
+
+    interface Sink {
+        fun pcm(packet: ByteArray)
+
+        fun conceal(slots: Int)
+
+        fun crossfade()
+    }
+
+    private class Item(
+        val frames: Int,
+        val payload: ByteArray?,
+        val concealSlots: Int,
+        val crossfade: Boolean,
+        val enqueuedNs: Long,
+    )
+
+    private val queue = ArrayBlockingQueue<Item>(capacity)
+
+    @Volatile private var running = false
+    private var worker: Thread? = null
+
+    @Volatile var decoder: FrameDecoder? = null
+        private set
+    @Volatile var decoderName: String = ""
+        private set
+    @Volatile private var decoderFailed = false
+
+    val framesDecoded = AtomicLong(0)
+    val decodeFailures = AtomicLong(0)
+    val queueDrops = AtomicLong(0)
+    val queueDepthMax = AtomicLong(0)
+    val queueWaitMaxNs = AtomicLong(0)
+    val decodeCallMaxNs = AtomicLong(0)
+
+    val queueDepth: Int get() = queue.size
+
+    fun start(threadName: String = "PrivyHub-Native-Audio-Opus") {
+        if (running) return
+        running = true
+        worker = Thread({ loop() }, threadName).apply {
+            isDaemon = true
+            start()
+        }
+    }
+
+    /** A frame in release order; [payload] null = given up (concealed as frames / 240 slots). Never blocks. */
+    fun offerFrame(frames: Int, payload: ByteArray?): Boolean =
+        offer(Item(frames, payload, 0, false, clock()))
+
+    /** An outage's concealment (today's cap) and, past the cap, the crossfade. Never blocks. */
+    fun offerConceal(slots: Int, crossfade: Boolean): Boolean =
+        offer(Item(0, null, slots, crossfade, clock()))
+
+    private fun offer(item: Item): Boolean {
+        if (!queue.offer(item)) {
+            queueDrops.incrementAndGet()
+            return false
+        }
+        max(queueDepthMax, queue.size.toLong())
+        return true
+    }
+
+    private fun max(cell: AtomicLong, value: Long) {
+        while (true) {
+            val old = cell.get()
+            if (value <= old || cell.compareAndSet(old, value)) return
+        }
+    }
+
+    private fun loop() {
+        try {
+            while (running) {
+                val item = try {
+                    queue.poll(POLL_MS, TimeUnit.MILLISECONDS)
+                } catch (_: InterruptedException) {
+                    if (!running) break else continue
+                } ?: continue
+                max(queueWaitMaxNs, clock() - item.enqueuedNs)
+                handle(item)
+            }
+        } finally {
+            decoder?.release()
+        }
+    }
+
+    private fun handle(item: Item) {
+        if (item.frames == 0) {
+            sink.conceal(item.concealSlots)
+            if (item.crossfade) sink.crossfade()
+            return
+        }
+        val slots = item.frames / OpusFraming.QUEUE_PACKET_FRAMES
+        val payload = item.payload
+        if (payload == null) {
+            sink.conceal(slots)
+            return
+        }
+        val d = decoder ?: if (decoderFailed) null else try {
+            decoderFactory(item.frames).also {
+                decoder = it
+                decoderName = it.name
+            }
+        } catch (_: Exception) {
+            decoderFailed = true
+            decoderName = "unavailable"
+            null
+        }
+        if (d == null) {
+            decodeFailures.incrementAndGet()
+            sink.conceal(slots)
+            return
+        }
+        var produced = 0
+        val t0 = clock()
+        val ok = try {
+            d.decode(payload) { pcm, length ->
+                for (chunk in OpusFraming.split(pcm, length)) {
+                    sink.pcm(chunk)
+                    produced += 1
+                }
+            }
+        } catch (_: Exception) {
+            false
+        }
+        max(decodeCallMaxNs, clock() - t0)
+        if (ok) {
+            framesDecoded.incrementAndGet()
+        } else {
+            decodeFailures.incrementAndGet()
+            if (produced == 0) sink.conceal(slots)
+        }
+    }
+
+    /** Stop the thread (it releases the decoder) and drop what is queued. */
+    fun stop() {
+        running = false
+        worker?.interrupt()
+        try {
+            worker?.join(JOIN_MS)
+        } catch (_: InterruptedException) {
+            Thread.currentThread().interrupt()
+        }
+        worker = null
+        queue.clear()
+    }
+}
diff --git a/PrivyHub/app/src/test/java/streaming/OpusDecodePipelineTest.kt b/PrivyHub/app/src/test/java/streaming/OpusDecodePipelineTest.kt
new file mode 100644
index 0000000..488f823
--- /dev/null
+++ b/PrivyHub/app/src/test/java/streaming/OpusDecodePipelineTest.kt
@@ -0,0 +1,131 @@
+package com.safeiot.privyhub.streaming
+
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * CL-B5: the decode off the receive thread. The offer never waits on the
+ * codec; the decode thread keeps the release order (frames, given-up frames
+ * and an outage's concealment interleaved); a full queue drops and counts;
+ * the maxima are tracked; stop releases the decoder.
+ */
+class OpusDecodePipelineTest {
+
+    /** "Decodes" a packet to 480 frames whose bytes all equal the packet's first byte. */
+    private class FakeDecoder(private val gate: CountDownLatch? = null, private val failOn: Int = -1) :
+        OpusDecodePipeline.FrameDecoder {
+        override val name = "fake"
+        @Volatile var released = false
+        @Volatile var calls = 0
+        override fun decode(packet: ByteArray, out: (ByteArray, Int) -> Unit): Boolean {
+            gate?.await(5, TimeUnit.SECONDS)
+            calls += 1
+            if (packet[0].toInt() == failOn) return false
+            out(ByteArray(1920) { packet[0] }, 1920)
+            return true
+        }
+        override fun release() { released = true }
+    }
+
+    private class Recorder : OpusDecodePipeline.Sink {
+        val events = java.util.Collections.synchronizedList(mutableListOf<String>())
+        override fun pcm(packet: ByteArray) { events += "pcm${packet[0]}" }
+        override fun conceal(slots: Int) { events += "conceal$slots" }
+        override fun crossfade() { events += "crossfade" }
+    }
+
+    private fun waitFor(cond: () -> Boolean) {
+        val deadline = System.nanoTime() + 5_000_000_000L
+        while (!cond() && System.nanoTime() < deadline) Thread.sleep(2)
+        assertTrue("timed out", cond())
+    }
+
+    @Test
+    fun theReleaseOrderIsKept() {
+        val dec = FakeDecoder()
+        val sink = Recorder()
+        val p = OpusDecodePipeline({ dec }, sink)
+        p.start()
+        p.offerFrame(480, byteArrayOf(1))
+        p.offerFrame(480, null)                 // given up: 2 slots
+        p.offerFrame(480, byteArrayOf(3))
+        p.offerConceal(6, true)                 // an outage past the cap
+        p.offerFrame(480, byteArrayOf(4))
+        waitFor { sink.events.size == 9 }
+        assertEquals(
+            listOf("pcm1", "pcm1", "conceal2", "pcm3", "pcm3", "conceal6", "crossfade", "pcm4", "pcm4"),
+            sink.events.toList(),
+        )
+        assertEquals(3, p.framesDecoded.get())
+        assertEquals("fake", p.decoderName)
+        p.stop()
+        assertTrue(dec.released)
+    }
+
+    @Test
+    fun theOfferNeverWaitsOnTheCodec() {
+        val gate = CountDownLatch(1)                       // the decoder blocks until released
+        val sink = Recorder()
+        val p = OpusDecodePipeline({ FakeDecoder(gate) }, sink, capacity = 8)
+        p.start()
+        val t0 = System.nanoTime()
+        var accepted = 0
+        for (i in 0 until 20) if (p.offerFrame(480, byteArrayOf(i.toByte()))) accepted += 1
+        val elapsedMs = (System.nanoTime() - t0) / 1_000_000
+        assertTrue("offers took $elapsedMs ms", elapsedMs < 200)
+        // one item is inside the blocked decode call, 8 queued; the rest dropped and counted
+        assertTrue(accepted in 8..9)
+        assertEquals((20 - accepted).toLong(), p.queueDrops.get())
+        assertEquals(8L, p.queueDepthMax.get())
+        gate.countDown()
+        waitFor { p.framesDecoded.get() == accepted.toLong() }
+        assertTrue(p.queueWaitMaxNs.get() > 0)
+        assertTrue(p.decodeCallMaxNs.get() > 0)
+        p.stop()
+    }
+
+    @Test
+    fun aFailedDecodeIsConcealedAndCounted() {
+        val sink = Recorder()
+        val p = OpusDecodePipeline({ FakeDecoder(failOn = 2) }, sink)
+        p.start()
+        p.offerFrame(480, byteArrayOf(1))
+        p.offerFrame(480, byteArrayOf(2))
+        p.offerFrame(480, byteArrayOf(3))
+        waitFor { sink.events.size == 5 }
+        assertEquals(listOf("pcm1", "pcm1", "conceal2", "pcm3", "pcm3"), sink.events.toList())
+        assertEquals(1L, p.decodeFailures.get())
+        p.stop()
+    }
+
+    @Test
+    fun noDecoderMeansConcealment() {
+        val sink = Recorder()
+        val p = OpusDecodePipeline({ throw IllegalStateException("no codec") }, sink)
+        p.start()
+        p.offerFrame(960, byteArrayOf(1))                  // 20-ms frame: 4 slots
+        p.offerFrame(480, byteArrayOf(2))
+        waitFor { sink.events.size == 2 }
+        assertEquals(listOf("conceal4", "conceal2"), sink.events.toList())
+        assertEquals("unavailable", p.decoderName)
+        assertEquals(2L, p.decodeFailures.get())
+        p.stop()
+    }
+
+    @Test
+    fun stopEndsTheThreadAndClears() {
+        val dec = FakeDecoder()
+        val p = OpusDecodePipeline({ dec }, Recorder())
+        p.start()
+        p.offerFrame(480, byteArrayOf(1))
+        waitFor { p.framesDecoded.get() == 1L }
+        p.stop()
+        assertTrue(dec.released)
+        assertEquals(0, p.queueDepth)
+        assertFalse(Thread.getAllStackTraces().keys.any { it.name == "PrivyHub-Native-Audio-Opus" && it.isAlive })
+    }
+}
