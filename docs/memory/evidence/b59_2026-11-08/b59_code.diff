+        self.assertIn("n64", out["systems"])
+        self.assertEqual(out["scan"], [["n64", "n64/one.z64", "z64"], ["n64", "n64/two.v64", "v64"],
+                                       ["snes", "games/snes/s.sfc", "sfc"]])
+        self.assertEqual(out["ids"], ["n64", "n64", "snes"])
+        self.assertEqual(out["catalog"], ["n64", "", {}])
