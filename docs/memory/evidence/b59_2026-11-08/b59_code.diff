+        self.assertEqual(n64.core_file({"PRIVYHUB_N64_CORE": "parallel_n64"}), "parallel_n64_libretro.so")
+        for bad in ("../x", "Mupen", "a b"):
+            with self.assertRaises(n64.N64Error):
+                n64.core_file({"PRIVYHUB_N64_CORE": bad})
