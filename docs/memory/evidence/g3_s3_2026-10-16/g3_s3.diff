+        self.assertIsNone(m.decide(OVERLAY_SRC, "/vod/a.mp4?media_token=" + p["media_token"], None))
+        st, body = m.decide(OVERLAY_SRC, "/vod/a.mp4?media_token=forged", None)
+        self.assertEqual((st, body["reason"]), (401, "media-token-unknown"))
