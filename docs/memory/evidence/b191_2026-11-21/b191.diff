+        return spec, arrays, report
+    _rw, _hw, ratio, bins, fitted, _hl = best
+    spec["letters"].update({
+        "places": {str(p): list(b) for p, b in places.items()}, "ratio": ratio, "glyph_min": round(glyph_min, 2),
+        "blank": {str(p): v for p, v in blank.items()}, "keys": fitted["keys"],
