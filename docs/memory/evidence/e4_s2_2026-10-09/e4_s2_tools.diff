+def _jsonl_files(paths: list) -> list:
+    seen, out = set(), []
+    for f in paths:
+        try:
+            lines = Path(f).read_text(errors="replace").splitlines()
+        except OSError:
+            continue
+        for l in lines:
+            if l not in seen:
+                seen.add(l)
+                try:
+                    out.append(json.loads(l))
+                except ValueError:
+                    pass
+    return out
+
