+            a["${stick}_stick_up"] = cx to 0.325f; a["${stick}_stick_down"] = cx to 0.495f
+            a["${stick}_stick_left"] = (cx - 0.095f) to 0.41f; a["${stick}_stick_right"] = (cx + 0.095f) to 0.41f
+        }
