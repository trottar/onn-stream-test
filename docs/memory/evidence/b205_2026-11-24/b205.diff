+                y0, y1 = max(0, pl["top"] - 2), min(a.shape[0], pl["bot"] + 3)
+                x0, x1 = max(0, g[1] - 2), min(a.shape[1], g[3] + 3)
+                crop = a[y0:y1, x0:x1].copy()
+                ink = _ink(a, pl["pol"], int(pl["r"]), contrast)[y0:y1, x0:x1]
+                out.append((pl["group"] + ch, crop, ink, pl["pol"]))
+    return out
+
