         assert t["reports"] == 2 and t["output_gap_ms_max"] == 40 and t["receiver_lost_packets_per_min"] == 3.0, t
+    # CL-B6: a run drop-in overriding an adopted key replaces it; any other is added (the former rule, unchanged)
