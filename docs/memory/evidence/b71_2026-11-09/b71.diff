diff --git a/PrivyHub/app/src/main/java/streaming/DiscChange.kt b/PrivyHub/app/src/main/java/streaming/DiscChange.kt
new file mode 100644
index 0000000..dfe7ac0
--- /dev/null
+++ b/PrivyHub/app/src/main/java/streaming/DiscChange.kt
@@ -0,0 +1,47 @@
+package com.safeiot.privyhub.streaming
+
+/**
+ * B71: "Change disc" in the paused game's bar, only on a multi-disc session (the host's `discs` > 1, from the launch
+ * response and the `status` poll). The chooser lists the discs with the current one marked; the pick goes to the
+ * host's `disc-swap` action and the bar says "Disc 2 of 4". `debug.privyhub.disc_change=0` = today (no entry).
+ */
+object DiscChange {
+    const val PROPERTY = "debug.privyhub.disc_change"
+    const val LABEL = "CHANGE DISC"
+    const val ENDPOINT = "disc-swap"
+
+    /** A session's discs: `disc` null = not known (after a LOAD the host cannot tell). */
+    data class State(val discs: Int, val disc: Int?)
+
+    /** Null unless the host said `discs` > 1 (absent, 0 or 1 = a one-disc game: today). */
+    fun fromValues(discs: Int?, disc: Int?): State? {
+        if (discs == null || discs <= 1) return null
+        return State(discs, disc?.takeIf { it in 1..discs })
+    }
+
+    fun showEntry(enabled: Boolean, state: State?): Boolean = enabled && state != null
+
+    /** "Disc 1" … "Disc n", " (in the tray)" beside the known current one. */
+    fun choices(state: State): List<String> =
+        (1..state.discs).map { i -> "Disc $i" + if (i == state.disc) " (in the tray)" else "" }
+
+    /** The chooser's row -> the disc asked for. */
+    fun discForChoice(index: Int): Int = index + 1
+
+    fun statusLine(state: State): String =
+        state.disc?.let { "Disc $it of ${state.discs}" } ?: "${state.discs} discs"
+
+    fun query(disc: Int): String = "disc=$disc"
+
+    fun progressLine(disc: Int): String = "Changing to disc $disc…"
+
+    fun parse(value: String?): Boolean = value?.trim().let { it != "0" && it != "off" }
+
+    fun fromSystem(): Boolean =
+        try {
+            val get = Class.forName("android.os.SystemProperties").getMethod("get", String::class.java)
+            parse(get.invoke(null, PROPERTY) as? String)
+        } catch (_: Throwable) {
+            parse(null)
+        }
+}
diff --git a/PrivyHub/app/src/test/java/streaming/B71DiscChangeTest.kt b/PrivyHub/app/src/test/java/streaming/B71DiscChangeTest.kt
new file mode 100644
index 0000000..210c186
--- /dev/null
+++ b/PrivyHub/app/src/test/java/streaming/B71DiscChangeTest.kt
@@ -0,0 +1,55 @@
+package com.safeiot.privyhub.streaming
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** B71: the "Change disc" entry only on a multi-disc session; the chooser's labels; "Disc 2 of 4"; the property. */
+class B71DiscChangeTest {
+
+    @Test
+    fun entryOnlyWithMoreThanOneDisc() {
+        assertFalse(DiscChange.showEntry(true, DiscChange.fromValues(null, null)))   // an old host / a one-disc game
+        assertFalse(DiscChange.showEntry(true, DiscChange.fromValues(0, null)))
+        assertFalse(DiscChange.showEntry(true, DiscChange.fromValues(1, 1)))
+        assertTrue(DiscChange.showEntry(true, DiscChange.fromValues(2, 1)))
+        assertTrue(DiscChange.showEntry(true, DiscChange.fromValues(4, null)))
+        assertFalse(DiscChange.showEntry(false, DiscChange.fromValues(4, 2)))      // the property off: today
+    }
+
+    @Test
+    fun choicesMarkTheCurrentDisc() {
+        assertEquals(listOf("Disc 1", "Disc 2 (in the tray)", "Disc 3", "Disc 4"),
+            DiscChange.choices(DiscChange.State(4, 2)))
+        assertEquals(listOf("Disc 1", "Disc 2"), DiscChange.choices(DiscChange.State(2, null)))   // unknown: none
+        assertEquals(2, DiscChange.discForChoice(1))
+        assertEquals("disc=2", DiscChange.query(2))
+    }
+
+    @Test
+    fun theStatusLine() {
+        assertEquals("Disc 2 of 4", DiscChange.statusLine(DiscChange.State(4, 2)))
+        assertEquals("4 discs", DiscChange.statusLine(DiscChange.State(4, null)))
+        assertEquals("Changing to disc 3…", DiscChange.progressLine(3))
+    }
+
+    @Test
+    fun theReplyParse() {
+        // the host's reply after a swap: discs 4, disc 3
+        assertEquals(DiscChange.State(4, 3), DiscChange.fromValues(4, 3))
+        // a disc out of range is treated as unknown, never shown as current
+        assertNull(DiscChange.fromValues(4, 7)?.disc)
+        assertNull(DiscChange.fromValues(2, 0)?.disc)
+    }
+
+    @Test
+    fun theProperty() {
+        assertTrue(DiscChange.parse(null))
+        assertTrue(DiscChange.parse(""))
+        assertFalse(DiscChange.parse("0"))
+        assertFalse(DiscChange.parse("off"))
+        assertEquals("debug.privyhub.disc_change", DiscChange.PROPERTY)
+    }
+}
diff --git a/companion/disc_swap.py b/companion/disc_swap.py
new file mode 100644
index 0000000..18d7f2f
--- /dev/null
+++ b/companion/disc_swap.py
@@ -0,0 +1,173 @@
+"""B71: "Change disc" on a multi-disc PS1 session (an `.m3u` with more than one disc), over RetroArch's network
+command port.
+
+RetroArch 1.22.2 has `DISK_EJECT_TOGGLE`, `DISK_NEXT` and `DISK_PREV` over the port (no argument, no reply, no
+set-index, no index query), so the index is read from RetroArch's own log lines in the game log:
+`[Disc] Setting disc in tray: k/n[ - <label>]`, `[Disc] Removed disk from tray.`, `[Disc] Ejected virtual disc tray.`,
+`[Disc] Closed virtual disc tray.` and the `Failed to ...` forms. Only the two numbers are ever read; the label is
+never kept or logged.
+
+The sequence is the Quick Menu's, with the game left paused: open the tray, step the selected disc to the target
+(each step confirmed by its line), close the tray; 0.4 s between commands. `PRIVYHUB_DISC_SWAP=0` = today (no
+multi-disc session is ever recognised, the action unknown). Design: docs/memory/evidence/b71_2026-11-09/.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import time
+from pathlib import Path
+from typing import Any, Callable
+
+ENV = "PRIVYHUB_DISC_SWAP"
+EJECT = "DISK_EJECT_TOGGLE"
+NEXT = "DISK_NEXT"
+PREV = "DISK_PREV"
+GAP_S = 0.4                 # between commands: each in its own pass of RetroArch's loop
+LINE_BOUND_S = 1.5          # each command's own log line
+POLL_S = 0.05
+CONTROL = "retroarch_network_disk_control"
+
+SET_RE = re.compile(r"\[Disc\] Setting disc in tray: (\d+)/(\d+)")
+REMOVED_RE = re.compile(r"\[Disc\] Removed dis[ck] from tray")
+EJECTED_RE = re.compile(r"\[Disc\] Ejected virtual disc tray")
+CLOSED_RE = re.compile(r"\[Disc\] Closed virtual disc tray")
+FAILED_RE = re.compile(r"\[Disc\] Failed to (?:set disc|remove dis[ck]|eject virtual disc tray|close virtual disc tray)")
+
+
+class DiscSwapError(Exception):
+    disc: int | None = None          # the disc RetroArch last reported (None = unknown)
+
+
+def enabled(environ: Any = None) -> bool:
+    env = os.environ if environ is None else environ
+    return (env.get(ENV) or "").strip() != "0"
+
+
+def m3u_discs(path: Path) -> int:
+    """The disc lines of an `.m3u` (non-empty, not `#`); 0 when unreadable."""
+    try:
+        text = Path(path).read_text(encoding="utf-8-sig", errors="replace")
+    except OSError:
+        return 0
+    return sum(1 for line in text.splitlines() if line.strip() and not line.strip().startswith("#"))
+
+
+def session_for(content_path: Any, system: str, environ: Any = None) -> dict[str, Any] | None:
+    """`{"discs": n, "disc": 1}` for a PS1 `.m3u` launch with n > 1 (the knob on); else None (= today)."""
+    if not enabled(environ) or str(system or "").strip().lower() != "ps1":
+        return None
+    p = Path(str(content_path or ""))
+    if p.suffix.lower() != ".m3u":
+        return None
+    n = m3u_discs(p)
+    return {"discs": n, "disc": 1} if n > 1 else None
+
+
+def last_index(text: str, discs: int) -> int | None:
+    """The newest `Setting disc in tray: k/n` with this n (1-based); None when there is none."""
+    found = None
+    for m in SET_RE.finditer(text or ""):
+        if int(m.group(2)) == int(discs):
+            found = int(m.group(1))
+    return found
+
+
+class LogTail:
+    """Reads the game log from an offset (the only reader of RetroArch's disc lines)."""
+
+    def __init__(self, path: Any, offset: int = 0):
+        self.path = Path(str(path)) if path else None
+        self.offset = int(offset)
+
+    def read(self) -> str:
+        if self.path is None:
+            return ""
+        try:
+            with self.path.open("rb") as h:
+                h.seek(self.offset)
+                data = h.read(256 * 1024)
+        except OSError:
+            return ""
+        self.offset += len(data)
+        return data.decode("utf-8", errors="replace")
+
+
+class Swapper:
+    """One swap: `send(cmd)` puts a command on the port; `tail` reads the log; `clock` / `sleep` injectable."""
+
+    def __init__(self, send: Callable[[str], Any], tail: LogTail, discs: int,
+                 clock: Callable[[], float] = time.monotonic, sleep: Callable[[float], None] = time.sleep):
+        self.send, self.tail, self.discs = send, tail, int(discs)
+        self.clock, self.sleep = clock, sleep
+        self.sent: list[str] = []
+        self.buf = ""
+
+    def _cmd(self, cmd: str) -> None:
+        self.sent.append(cmd)
+        self.send(cmd)
+
+    def _await(self, *patterns: re.Pattern) -> re.Match | None:
+        """The first line matching any pattern (or a failure line) within the bound; None at the bound."""
+        deadline = self.clock() + LINE_BOUND_S
+        while True:
+            self.buf += self.tail.read()
+            best = None
+            for p in (*patterns, FAILED_RE):
+                m = p.search(self.buf)
+                if m and (best is None or m.start() < best.start()):
+                    best = m
+            if best is not None:
+                self.buf = self.buf[best.end():]
+                return best
+            if self.clock() >= deadline:
+                return None
+            self.sleep(POLL_S)
+
+    def run(self, current: int | None, target: int) -> dict[str, Any]:
+        n = self.discs
+        steps = 0
+        self.buf += self.tail.read()          # anything before the first command is not ours
+        self.buf = ""
+        self._cmd(EJECT)
+        m = self._await(EJECTED_RE)
+        if m is None or m.re is FAILED_RE:
+            err = DiscSwapError("the tray did not open" if m is None else "RetroArch could not open the tray")
+            err.disc = current
+            raise err
+        cur = current
+        try:
+            while cur != target:
+                if steps >= 2 * n:
+                    raise DiscSwapError(f"disc {target} not reached in {steps} steps")
+                self.sleep(GAP_S)
+                self._cmd(NEXT if (cur is None or cur < target) else PREV)
+                steps += 1
+                m = self._await(SET_RE, REMOVED_RE)
+                if m is None:
+                    raise DiscSwapError("no disc line from RetroArch")
+                if m.re is FAILED_RE:
+                    raise DiscSwapError("RetroArch could not set the disc")
+                if m.re is REMOVED_RE:
+                    cur = n + 1                # past the end: no disc selected
+                else:
+                    if int(m.group(2)) != n:
+                        raise DiscSwapError("the disc count RetroArch reports differs")
+                    cur = int(m.group(1))
+        except DiscSwapError as exc:
+            self._close()
+            err = DiscSwapError(str(exc))
+            err.disc = cur if cur is None or 1 <= cur <= n else None
+            raise err from exc
+        self.sleep(GAP_S)
+        if not self._close():
+            err = DiscSwapError("the tray did not close")
+            err.disc = cur
+            raise err
+        return {"disc": cur, "steps": steps}
+
+    def _close(self) -> bool:
+        self._cmd(EJECT)
+        m = self._await(CLOSED_RE)
+        return m is not None and m.re is CLOSED_RE
