+    @staticmethod
+    def _mem_probe(op: str) -> dict[str, Any]:
+        import ctypes
+        import gc
+        import sys
+        import tracemalloc
+
+        out: dict[str, Any] = {"op": op}
+        if op == "start" and not tracemalloc.is_tracing():
+            tracemalloc.start(1)
+        elif op == "gc":
+            out["collected"] = gc.collect()
+        elif op == "trim":
+            out["malloc_trim"] = ctypes.CDLL("libc.so.6").malloc_trim(0)
+        if tracemalloc.is_tracing():
+            current, peak = tracemalloc.get_traced_memory()
+            out["traced_mb"] = round(current / 1048576, 2)
+            out["traced_peak_mb"] = round(peak / 1048576, 2)
+            top = tracemalloc.take_snapshot().statistics("filename")[:8]
+            out["traced_top"] = [
+                [Path(str(st.traceback[0].filename)).name, round(st.size / 1048576, 2), st.count]
+                for st in top
+            ]
+        sizes: dict[str, list[int]] = {}
+        for obj in gc.get_objects():
+            row = sizes.setdefault(type(obj).__name__, [0, 0])
+            row[0] += 1
+            row[1] += sys.getsizeof(obj)
+        out["gc_objects_top"] = sorted(
+            ([k, v[0], round(v[1] / 1048576, 2)] for k, v in sizes.items()),
+            key=lambda r: -r[2],
+        )[:8]
+        try:
+            text = Path("/proc/self/smaps_rollup").read_text()
+            for key in ("Rss", "Pss", "Pss_Anon", "Pss_File", "Anonymous"):
+                for line in text.splitlines():
+                    if line.startswith(key + ":"):
+                        out[key.lower() + "_mb"] = round(int(line.split()[1]) / 1024, 1)
+        except OSError:
+            pass
+        return out
