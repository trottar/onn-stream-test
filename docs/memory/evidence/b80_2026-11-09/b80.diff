+        p._emulator = types.SimpleNamespace(
+            ps2_patches=lambda g: offer,
+            set_ps2_patches=lambda g, w: (stored.update(w), {"available": ["ws"], "on": ["ws"] if w["ws"] else []})[1])
+        return p, stored
