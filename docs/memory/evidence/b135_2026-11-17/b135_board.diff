+## The players' choice on the stage's selection screen: one or two cards (the first today's seeded pick, the second
+## another seeded from the rest), {"card": 0 | 1 | -1}; -1 (Random) a seeded pick between the two. Anything else:
+## today's pick.
+func _choose(random: RandomNumberGenerator, fitting: Array, first: String, titles: Dictionary, players: Array) -> String:
+	var ids: Array = [first]
+	if fitting.size() >= 2:
+		var others := fitting.filter(func(x): return x != first)
+		ids.append(others[random.randi_range(0, others.size() - 1)])
+	var cards: Array = []
+	for one in ids:
+		cards.append({"title": str(titles.get(one, ""))})
+	var answer = await stage.choose_minigame(cards, players)
+	var card := -2
+	if typeof(answer) == TYPE_DICTIONARY:
+		card = int(answer.get("card", -2))
+	if card == -1 and ids.size() == 2:
+		return ids[random.randi_range(0, 1)]
+	if card >= 0 and card < ids.size():
+		return ids[card]
+	return first
+
+
+## Whether the stage has the load screen (all four of its methods): else the mini game plays as before.
+func _has_screens() -> bool:
+	if stage == null:
+		return false
+	for method in LOADING_METHODS:
+		if not stage.has_method(method):
+			return false
+	return true
+
+
+## The load screen taken down on every way out (with nothing shown the stage does nothing).
+func _hide() -> void:
+	if stage != null and stage.has_method("hide_minigame_loading"):
+		stage.hide_minigame_loading()
+
