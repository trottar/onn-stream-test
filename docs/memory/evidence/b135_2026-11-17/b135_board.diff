+## Queue AU: the stand-in hub for a held start — preparing for two result calls, ready from the third; the go
+## (refused unless ready); a practice plays two calls then prepares again; a plain go plays two calls then ends.
+func _held_answer(scenario: String, action: String, path: String) -> Array:
+	var body := {"ok": true}
+	match action:
+		"party-minigames":
+			body["minigames"] = [{"id": "mg_a", "players": 2, "title": "Made-up A"}]
+			if scenario != "hone":
+				body["minigames"].append({"id": "mg_b", "players": 2, "title": "Made-up B"})
+		"party-minigame-start":
+			if scenario == "hrefused":
+				return [400, {"ok": false, "error": "a mini game is already on"}]
+			_hub[scenario] = {"mode": "prep", "k": 0, "p": 0, "practices": 0}
+			body["state"] = "starting"
+		"party-minigame-result":
+			if scenario == "hsilent" and _hub.get(scenario, {}).get("k", 0) >= 2:
+				return [500, {"ok": false, "error": "the hub is busy"}]
+			var st: Dictionary = _hub.get(scenario, {"mode": "prep", "k": 0, "p": 0, "practices": 0})
+			_hub[scenario] = st
+			if not _hfps.has(scenario):
+				_hfps[scenario] = []
+			_hfps[scenario].append([st["mode"], Engine.max_fps])
+			if st["mode"] == "prep":
+				st["k"] += 1
+				if scenario == "hsilent":
+					body.merge({"state": "starting", "phase": "preparing"})
+				elif scenario == "hgiveup" and st["k"] >= 2:
+					body.merge({"state": "given_up", "why": "the title's start screen was not recognised", "scores": null})
+				else:
+					body.merge({"state": "starting", "phase": "ready" if st["k"] >= 3 else "preparing",
+						"practices": st["practices"]})
+			elif st["mode"] == "practice":
+				st["p"] += 1
+				if st["p"] <= 2:
+					body.merge({"state": "playing", "practice": true, "practices": st["practices"]})
+				else:
+					st["mode"] = "prep"
+					st["k"] = 0
+					st["practices"] += 1
+					body.merge({"state": "starting", "phase": "preparing", "practices": st["practices"]})
+			else:
+				st["p"] += 1
+				if st["p"] <= 2:
+					body.merge({"state": "playing", "recognised": true})
+				else:
+					body.merge({"state": "ended", "class": "end_P1", "scores": [1, 0]})
+		"party-minigame-go":
+			var st: Dictionary = _hub.get(scenario, {"mode": "none", "k": 0})
+			var phase := "ready" if st["mode"] == "prep" and int(st["k"]) >= 3 else str(st["mode"])
+			if not _go_phase_list.has(scenario):
+				_go_phase_list[scenario] = []
+				_go_kinds[scenario] = []
+			_go_phase_list[scenario].append(phase)
+			_go_kinds[scenario].append("practice" if path.contains("practice=1") else "start")
+			_go_reads[scenario] = _screens.reads if _screens != null else -1
+			if phase != "ready":
+				return [400, {"ok": false, "error": "no mini game is waiting for the go"}]
+			st["mode"] = "practice" if path.contains("practice=1") else "play"
+			st["p"] = 0
+			body.merge({"go": "taken", "phase": "ready"})
+		"party-minigame-end":
+			_fps_at_end[scenario] = Engine.max_fps
+			body["ended"] = true
+		_:
+			return [404, {"ok": false, "error": "Unknown Games plugin action"}]
+	return [200, body]
+
