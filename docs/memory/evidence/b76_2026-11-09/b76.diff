+def run_metadata_dry_run(
+    project_root: Path,
+    *,
+    offline: bool = False,
+    only_system: str = "",
+    environ: Any = None,
+    provider: "LibretroProvider | None" = None,
+    games: list[dict[str, Any]] | None = None,
