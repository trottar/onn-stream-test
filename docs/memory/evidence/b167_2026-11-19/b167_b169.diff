+        self.assertEqual(self.cap.hub_core("n64"), "mupen64plus_next_libretro.so")
+
+
+def _tool(*argv):
+    import party_add_game as pag
+    buf = io.StringIO()
+    with contextlib.redirect_stdout(buf):
+        rc = pag.main([str(a) for a in argv])
+    return rc, buf.getvalue()
+
+
