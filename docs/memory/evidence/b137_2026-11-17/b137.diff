+                else:
+                    layer.practice_s = 0.5
+                b = wait_phase(lambda b: b.get("phase") == "ready" or b.get("state") in ("ended", "given_up"), 30)
+                layer.practice_s = 90.0
+                S[f"n2_back{n + 1}"] = {k: b.get(k) for k in ("state", "phase", "practices")}
+            time.sleep(0.6)
+            t_go = time.monotonic()
