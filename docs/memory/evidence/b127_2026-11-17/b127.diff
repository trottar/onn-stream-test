+
+    def test_3_a_setup_not_on_the_hub_refused_plainly_nothing_launched(self):
+        for tag, check in (("c_ref_no_profile", "no_profile"), ("c_ref_folder_gone", "no_profile"),
+                           ("c_ref_indexes_changed", "profile_differs")):
