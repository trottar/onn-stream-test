+            b124.IDS.clear()
+            b124.IDS.update(ids)
+            outs.append(b114.run(root, b114.BOTH, ids, "four", extra=b124.extra)["steps"])
+        base, mine = outs
+        for tag in ("a2", "b4", "c2", "d4"):
