diff --git a/PrivyHub/app/src/main/java/streaming/SurfaceHold.kt b/PrivyHub/app/src/main/java/streaming/SurfaceHold.kt
new file mode 100644
index 0000000000000000000000000000000000000000..e8b3dee927b8f8f3352d4a6076bc58bf3181142a
--- /dev/null
+++ b/PrivyHub/app/src/main/java/streaming/SurfaceHold.kt
@@ -0,0 +1,330 @@
+package com.safeiot.privyhub.streaming
+
+import java.net.URLEncoder
+
+/**
+ * B32: the stream survives a brief loss of the screen, behind the system property `debug.privyhub.surface_hold`
+ * (CL-B7P's convention; a reboot clears it). **Absent / empty / `0` / junk = today: no object.**
+ *
+ * TRIP-R2 §1: six self-restarts in an evening, each `trigger: surface` -- Android took the stream activity out of the
+ * foreground for 1-9 s, the surface went, the same instance came back and started a new stream (a new host session,
+ * the rung back to the start). Here, on `surfaceDestroyed` the activity keeps the receiver, the audio and the
+ * controller sender running (the decoder closed: it cannot outlive its surface) for up to [boundMs]; a surface back
+ * within the bound continues the same session (no `native-stream-start`); past it, today's restart path. Every loss
+ * becomes one `surface_lost` row (its cause as far as the activity can see it), sent at the next heartbeat. A system
+ * key (guide / Home class) from a pad is consumed in the stream activity; the remote's passes as today.
+ * Design: `docs/memory/evidence/b32_2026-10-31/design_written_before_code.md` (hashed before this code).
+ */
+object SurfaceHoldFlag {
+    const val PROPERTY = "debug.privyhub.surface_hold"
+    const val DEFAULT_BOUND_MS = 12_000L
+    const val MIN_BOUND_MS = 10_000L
+    const val MAX_BOUND_MS = 30_000L
+
+    /** `1` = the default bound; an integer in range = that bound; anything else (absent included) = off (null). */
+    fun parse(value: String?): Long? {
+        val v = value?.trim() ?: return null
+        if (v == "1") return DEFAULT_BOUND_MS
+        val n = v.toLongOrNull() ?: return null
+        return if (n in MIN_BOUND_MS..MAX_BOUND_MS) n else null
+    }
+
+    /** The property, read through reflection; a failed read is absent, so off. */
+    fun fromSystem(): Long? =
+        try {
+            val get = Class.forName("android.os.SystemProperties").getMethod("get", String::class.java)
+            parse(get.invoke(null, PROPERTY) as? String)
+        } catch (_: Throwable) {
+            null
+        }
+}
+
+class SurfaceHold(val boundMs: Long, private val clockMs: () -> Long = { System.nanoTime() / 1_000_000L }) {
+    companion object {
+        const val WINDOW_MS = 2_000L
+        const val MAX_ROWS = 8
+        const val MAX_KEYS = 8
+        const val MAX_DEVICES = 4
+        const val MAX_ROW_CHARS = 1_024
+
+        // android.view.KeyEvent / InputDevice constants (inlined values, so the JVM tests need no framework)
+        const val KEYCODE_HOME = 3
+        const val KEYCODE_MENU = 82
+        const val KEYCODE_SEARCH = 84
+        const val KEYCODE_NOTIFICATION = 83
+        const val KEYCODE_BUTTON_MODE = 110
+        const val KEYCODE_GUIDE = 172
+        const val KEYCODE_SETTINGS = 176
+        const val KEYCODE_APP_SWITCH = 187
+        const val KEYCODE_ASSIST = 219
+        const val KEYCODE_VOICE_ASSIST = 231
+        const val KEYCODE_ALL_APPS = 284
+        const val SOURCE_GAMEPAD = 0x00000401
+        const val SOURCE_JOYSTICK = 0x01000010
+        const val SOURCE_KEYBOARD = 0x00000101
+        const val SOURCE_DPAD = 0x00000201
+
+        val SYSTEM_KEYS = setOf(
+            KEYCODE_BUTTON_MODE, KEYCODE_GUIDE, KEYCODE_MENU, KEYCODE_SEARCH, KEYCODE_SETTINGS, KEYCODE_HOME,
+            KEYCODE_ALL_APPS, KEYCODE_ASSIST, KEYCODE_VOICE_ASSIST, KEYCODE_NOTIFICATION, KEYCODE_APP_SWITCH,
+        )
+
+        fun sourceClass(sources: Int): String = when {
+            (sources and SOURCE_GAMEPAD) == SOURCE_GAMEPAD || (sources and SOURCE_JOYSTICK) == SOURCE_JOYSTICK -> "pad"
+            (sources and SOURCE_KEYBOARD) == SOURCE_KEYBOARD || (sources and SOURCE_DPAD) == SOURCE_DPAD -> "remote"
+            else -> "other"
+        }
+    }
+
+    private class KeySeen(val atMs: Long, val code: Int, val cls: String, val consumed: Boolean)
+    private class DeviceSeen(val atMs: Long, val kind: String, val cls: String)
+
+    private val lock = Any()
+    private val keys = ArrayDeque<KeySeen>()
+    private val devices = ArrayDeque<DeviceSeen>()
+    private val rows = ArrayDeque<String>()
+
+    private var focusLostAtMs = -1L
+    private var topLostAtMs = -1L
+    private var userLeaveAtMs = -1L
+    private var pausedAtMs = -1L
+
+    // the open loss
+    @Volatile
+    var holding = false
+        private set
+    private var lostAtMs = -1L
+    private var ageAtLossMs = 0L
+    private var lossFields: MutableMap<String, Any?>? = null
+
+    // after a re-attach, until the new decoder's first frame
+    @Volatile
+    private var awaitingFirstFrame = false
+    private var backAtMs = -1L
+    private var pendingHeldRow: MutableMap<String, Any?>? = null
+
+    var losses = 0L; private set
+    var held = 0L; private set
+    var restarted = 0L; private set
+    var endedInHold = 0L; private set
+    var decodersBuilt = 0L; private set
+    var renderedBeforeReattach = 0L; private set
+    var padSystemKeysConsumed = 0L; private set
+    var systemKeysPassed = 0L; private set
+    var rowsQueued = 0L; private set
+    var rowsSent = 0L; private set
+    var rowsDropped = 0L; private set
+    private var seq = 0L
+
+    // --- what the activity sees -------------------------------------------------------------------------------------
+
+    /** `dispatchKeyEvent`, before anything else. True = consume it (a system-class key from a pad). */
+    fun onKey(keyCode: Int, keyDown: Boolean, sources: Int): Boolean {
+        val cls = sourceClass(sources)
+        val system = keyCode in SYSTEM_KEYS
+        val consume = system && cls == "pad"
+        synchronized(lock) {
+            if (keyDown) {
+                keys.addLast(KeySeen(clockMs(), keyCode, cls, consume))
+                while (keys.size > 32) keys.removeFirst()
+                if (consume) padSystemKeysConsumed++ else if (system) systemKeysPassed++
+            }
+        }
+        return consume
+    }
+
+    fun onDevice(kind: String, sources: Int) {
+        synchronized(lock) {
+            devices.addLast(DeviceSeen(clockMs(), kind, sourceClass(sources)))
+            while (devices.size > 16) devices.removeFirst()
+        }
+    }
+
+    fun onFocus(hasFocus: Boolean) {
+        if (!hasFocus) focusLostAtMs = clockMs()
+    }
+
+    fun onTopResumed(isTop: Boolean) {
+        if (!isTop) topLostAtMs = clockMs()
+    }
+
+    fun onUserLeave() {
+        userLeaveAtMs = clockMs()
+    }
+
+    fun onPause() {
+        pausedAtMs = clockMs()
+    }
+
+    // --- the loss -------------------------------------------------------------------------------------------------
+
+    /** `surfaceDestroyed` (a session started, not finishing): the hold begins; the cause is read now. */
+    fun onSurfaceLost(lastOutputAgeMs: Long, interactive: Boolean?) {
+        val now = clockMs()
+        synchronized(lock) {
+            losses++
+            holding = true
+            awaitingFirstFrame = false
+            lostAtMs = now
+            ageAtLossMs = lastOutputAgeMs.coerceAtLeast(0L)
+            fun before(at: Long): Long = if (at >= 0L && now - at <= 60_000L) now - at else -1L
+            val recentKeys = keys.filter { now - it.atMs <= WINDOW_MS }.takeLast(MAX_KEYS)
+            val recentDevices = devices.filter { now - it.atMs <= WINDOW_MS }.takeLast(MAX_DEVICES)
+            val leave = before(userLeaveAtMs).let { it in 0..10_000L }
+            val reason = when {
+                recentKeys.any { it.code in SYSTEM_KEYS && it.cls == "pad" } -> "pad_system_key"
+                recentKeys.any { it.code in SYSTEM_KEYS } -> "remote_system_key"
+                leave -> "user_leave"
+                interactive == false -> "screen_off"
+                recentDevices.isNotEmpty() -> "input_device"
+                before(topLostAtMs) >= 0L -> "top_lost"
+                before(focusLostAtMs) >= 0L -> "focus_lost"
+                else -> "unknown"
+            }
+            lossFields = linkedMapOf(
+                "reason" to reason,
+                "bound_ms" to boundMs,
+                "paused_before_ms" to before(pausedAtMs),
+                "focus_lost_before_ms" to before(focusLostAtMs),
+                "top_lost_before_ms" to before(topLostAtMs),
+                "user_leave" to leave,
+                "interactive" to interactive,
+                "keys" to recentKeys.map { "${it.code}:${it.cls}:${if (it.consumed) "c" else "p"}" },
+                "devices" to recentDevices.map { "${it.kind}:${it.cls}:${now - it.atMs}" },
+            )
+        }
+    }
+
+    /** True while the bound has run out with no surface back (the activity then runs today's path). */
+    fun expired(nowMs: Long = clockMs()): Boolean = holding && nowMs - lostAtMs >= boundMs
+
+    /** `surfaceCreated`: true = within the bound, the same session continues (no start). False = today's start. */
+    fun onSurfaceBack(): Boolean {
+        val now = clockMs()
+        synchronized(lock) {
+            if (!holding) return false
+            if (now - lostAtMs >= boundMs) return false
+            holding = false
+            held++
+            awaitingFirstFrame = true
+            backAtMs = now
+            pendingHeldRow = (lossFields ?: linkedMapOf()).apply {
+                put("outcome", "held")
+                put("away_ms", now - lostAtMs)
+            }
+            lossFields = null
+            return true
+        }
+    }
+
+    /** The expiry with no surface back: the row is `restarted`; the activity runs today's surface-loss path. */
+    fun onExpired() {
+        val now = clockMs()
+        synchronized(lock) {
+            if (!holding) return
+            holding = false
+            restarted++
+            queue((lossFields ?: linkedMapOf()).apply {
+                put("outcome", "restarted")
+                put("away_ms", now - lostAtMs)
+                put("first_frame_ms", -1L)
+            })
+            lossFields = null
+        }
+    }
+
+    /** The activity ends inside a hold (today's stop path runs); no row (no heartbeat follows). */
+    fun onEndedInHold() {
+        synchronized(lock) {
+            if (!holding) return
+            holding = false
+            endedInHold++
+            lossFields = null
+        }
+    }
+
+    /** A decoder built (the first, or one on the re-attached surface); [closedRendered] = the old one's frames. */
+    fun onDecoderClosed(closedRendered: Long) {
+        synchronized(lock) { renderedBeforeReattach += closedRendered.coerceAtLeast(0L) }
+    }
+
+    fun onDecoderBuilt() {
+        synchronized(lock) { decodersBuilt++ }
+    }
+
+    /**
+     * The stall signal's output age while the player cannot see the game: the age at the loss plus the time since,
+     * through the hold and until the re-attached decoder renders. Null = not holding (the real age is used).
+     */
+    fun stallAgeMs(nowMs: Long, renderedFrames: Long): Long? {
+        if (holding) return ageAtLossMs + (nowMs - lostAtMs).coerceAtLeast(0L)
+        if (!awaitingFirstFrame) return null
+        if (renderedFrames > 0L) {
+            synchronized(lock) {
+                if (awaitingFirstFrame) {
+                    awaitingFirstFrame = false
+                    pendingHeldRow?.let { r -> r["first_frame_ms"] = nowMs - backAtMs; queue(r) }
+                    pendingHeldRow = null
+                }
+            }
+            return null
+        }
+        return ageAtLossMs + (nowMs - lostAtMs).coerceAtLeast(0L)
+    }
+
+    // --- the rows -------------------------------------------------------------------------------------------------
+
+    private fun queue(r: MutableMap<String, Any?>) {
+        seq++
+        val row = linkedMapOf<String, Any?>("seq" to seq)
+        row.putAll(r)
+        if (!row.containsKey("first_frame_ms")) row["first_frame_ms"] = -1L
+        rows.addLast(encode(row))
+        rowsQueued++
+        while (rows.size > MAX_ROWS) {
+            rows.removeFirst()
+            rowsDropped++
+        }
+    }
+
+    /** The heartbeat's key: one queued row (oldest first), or "" (nothing queued). */
+    fun query(): String {
+        val r = synchronized(lock) { rows.removeFirstOrNull() } ?: return ""
+        rowsSent++
+        return "&surface_lost=" + URLEncoder.encode(r, "UTF-8")
+    }
+
+    fun pendingRows(): List<String> = synchronized(lock) { rows.toList() }
+
+    /** The report's `surface_hold` object (numbers only). */
+    fun reportFields(): Map<String, Any> = linkedMapOf(
+        "bound_ms" to boundMs,
+        "losses" to losses,
+        "held" to held,
+        "restarted" to restarted,
+        "ended_in_hold" to endedInHold,
+        "decoders_built" to decodersBuilt,
+        "rendered_before_reattach" to renderedBeforeReattach,
+        "pad_system_keys_consumed" to padSystemKeysConsumed,
+        "system_keys_passed" to systemKeysPassed,
+        "rows_queued" to rowsQueued,
+        "rows_sent" to rowsSent,
+        "rows_dropped" to rowsDropped,
+    )
+
+    /** Compact JSON of numbers, booleans, null, fixed words and lists of fixed words; capped at [MAX_ROW_CHARS]. */
+    internal fun encode(row: Map<String, Any?>): String {
+        fun v(x: Any?): String = when (x) {
+            null -> "null"
+            is Boolean, is Int, is Long -> x.toString()
+            is List<*> -> x.joinToString(",", "[", "]") { v(it) }
+            else -> "\"" + x.toString().filter { it.isLetterOrDigit() || it == '_' || it == ':' || it == '-' } + "\""
+        }
+        val s = row.entries.joinToString(",", "{", "}") { (k, x) -> "\"$k\":${v(x)}" }
+        if (s.length <= MAX_ROW_CHARS) return s
+        val short = LinkedHashMap(row)
+        short["keys"] = emptyList<String>()
+        short["devices"] = emptyList<String>()
+        return short.entries.joinToString(",", "{", "}") { (k, x) -> "\"$k\":${v(x)}" }
+    }
+}
diff --git a/PrivyHub/app/src/test/java/streaming/SurfaceHoldTest.kt b/PrivyHub/app/src/test/java/streaming/SurfaceHoldTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..1efed0faeef5504096e3fdbdb18572c66b857b8e
--- /dev/null
+++ b/PrivyHub/app/src/test/java/streaming/SurfaceHoldTest.kt
@@ -0,0 +1,394 @@
+package com.safeiot.privyhub.streaming
+
+import java.io.File
+import java.net.DatagramPacket
+import java.net.DatagramSocket
+import java.net.InetAddress
+import java.net.SocketTimeoutException
+import java.net.URLDecoder
+import java.nio.ByteBuffer
+import java.nio.file.Files
+import java.util.Collections
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * B32: the hold through a brief loss of the screen. B15's style: the activity's surface paths modelled as the activity
+ * calls them (`surfaceDestroyed` / `surfaceCreated` / the expiry / the parameter-set callback), against the real
+ * [SurfaceHold], the real [RestartGuard] with a file store, the real [RtpH264Receiver] on loopback, the real
+ * [NativeControllerSender] sending to a loopback socket, the real [StallMonitor], and a fake host counting starts.
+ */
+class SurfaceHoldTest {
+
+    private val dir: File = Files.createTempDirectory("b32_store_").toFile()
+
+    private fun freePort(): Int = DatagramSocket(0).use { it.localPort }
+
+    /** The controller's uplink as the host's socket sees it: arrival times of every datagram. */
+    private class Uplink {
+        val socket = DatagramSocket(0, InetAddress.getLoopbackAddress()).apply { soTimeout = 50 }
+        val arrivals: MutableList<Long> = Collections.synchronizedList(mutableListOf<Long>())
+        val stalls: MutableList<Int> = Collections.synchronizedList(mutableListOf<Int>())
+        @Volatile var running = true
+        private val t = Thread {
+            val buf = ByteArray(64)
+            while (running) {
+                val p = DatagramPacket(buf, buf.size)
+                try {
+                    socket.receive(p)
+                    arrivals.add(System.nanoTime() / 1_000_000L)
+                    if (p.length == StallPacket.SIZE && buf[0] == 'P'.code.toByte() && buf[2] == 'S'.code.toByte()) {
+                        stalls.add(buf[4].toInt())
+                    }
+                } catch (_: SocketTimeoutException) {
+                }
+            }
+        }.apply { isDaemon = true; start() }
+
+        fun maxGapMs(fromMs: Long, toMs: Long): Long {
+            val a = synchronized(arrivals) { arrivals.filter { it in fromMs..toMs }.sorted() }
+            if (a.isEmpty()) return Long.MAX_VALUE
+            var g = a.first() - fromMs
+            for (i in 1 until a.size) g = maxOf(g, a[i] - a[i - 1])
+            return maxOf(g, toMs - a.last())
+        }
+
+        fun close() { running = false; t.join(500); socket.close() }
+    }
+
+    private class Wire(val port: Int, var seq: Int = 100) {
+        private val tx = DatagramSocket()
+        private var ts = 90_000L
+        fun au(idr: Boolean) {
+            val nal = byteArrayOf(if (idr) 0x65 else 0x41, 0x11, 0x22, 0x33, 0x44)
+            val p = ByteBuffer.allocate(12 + nal.size)
+            p.put(0x80.toByte()).put((0x80 or 96).toByte()).putShort(seq.toShort()).putInt(ts.toInt()).putInt(0x1234)
+            p.put(nal)
+            seq = (seq + 1) and 0xffff
+            ts += 1500L
+            tx.send(DatagramPacket(p.array(), p.capacity(), InetAddress.getLoopbackAddress(), port))
+            Thread.sleep(3)
+        }
+        fun close() = tx.close()
+    }
+
+    /** A fake decoder: built only on a live surface; renders what it is given. */
+    private class FakeDecoder(val surface: String) {
+        var rendered = 0L
+    }
+
+    /**
+     * The activity's B32 paths with the hold (or, [hold] null, today's): the start, the surface's loss and return,
+     * the expiry, the parameter-set callback. Posts go to [posts].
+     */
+    private inner class ActivityModel(val hold: SurfaceHold?, val guard: RestartGuard?, uplinkPort: Int, videoPort: Int) {
+        val posts: MutableList<String> = Collections.synchronizedList(mutableListOf<String>())
+        var sessionStarted = false
+        var sender: NativeControllerSender? = null
+        var receiver: RtpH264Receiver? = null
+        @Volatile var decoder: FakeDecoder? = null
+        @Volatile var heldSurface: String? = null
+        val monitor = StallMonitor(150L)
+        val upPort = uplinkPort
+        val vPort = videoPort
+        val accessUnits = Collections.synchronizedList(mutableListOf<Int>())
+
+        fun stallInputs(nowMs: Long): StallInputs {
+            val i = StallInputs(outputAgeMs = if (decoder != null) 16L else -1L, renderedFrames = decoder?.rendered ?: 0L,
+                inGate = false, released = true)
+            return hold?.stallAgeMs(nowMs, i.renderedFrames)?.let { a -> i.copy(outputAgeMs = a) } ?: i
+        }
+
+        fun startSession(surface: String) {
+            if (sessionStarted) return
+            sessionStarted = true
+            heldSurface = surface
+            val restart = guard?.takePending()
+            restart?.let { p -> guard?.beginViaStart(p) }
+            posts.add(if (restart != null) "start&guard_end=1" else "start")
+            sender = NativeControllerSender("127.0.0.1", upPort).also { s ->
+                s.stallTick = { now -> monitor.tick(now, stallInputs(now)) }
+                s.start()
+            }
+            receiver = RtpH264Receiver(
+                port = vPort,
+                onParameterSets = { _, _ -> },
+                onAccessUnit = { _, _ ->
+                    accessUnits.add(1)
+                    // the parameter-set callback's rule: a decoder only on a live surface (the hold), or the closure's
+                    if (decoder == null) {
+                        val target = if (hold != null) heldSurface else surface
+                        if (target != null) { decoder = FakeDecoder(target); hold?.onDecoderBuilt() }
+                    }
+                    decoder?.let { it.rendered++ }
+                },
+            ).also { it.start() }
+            Thread.sleep(150)
+        }
+
+        fun surfaceDestroyed(finishing: Boolean = false) {
+            if (sessionStarted && !finishing && hold != null) {
+                hold.onSurfaceLost(16L, true)
+                sender?.neutralize()
+                heldSurface = null
+                decoder?.let { hold.onDecoderClosed(it.rendered) }
+                decoder = null
+                return
+            }
+            if (sessionStarted) guard?.onSurfaceLost("{\"r\":1}", 16L, 10L, false)
+            stopLocalPipeline()
+            sessionStarted = false
+        }
+
+        fun surfaceCreated(surface: String) {
+            if (hold != null && sessionStarted && hold.onSurfaceBack()) {
+                heldSurface = surface
+                return
+            }
+            startSession(surface)
+        }
+
+        fun expiry() {
+            val h = hold ?: return
+            if (!h.holding || !h.expired()) return
+            h.onExpired()
+            guard?.onSurfaceLost("{\"r\":1}", -1L, -1L, false)
+            stopLocalPipeline()
+            sessionStarted = false
+        }
+
+        fun stopLocalPipeline() {
+            sender?.stop(); sender = null
+            receiver?.stop(); receiver = null
+            decoder = null
+        }
+    }
+
+    private fun decodeRow(q: String): String {
+        assertTrue(q, q.startsWith("&surface_lost="))
+        return URLDecoder.decode(q.removePrefix("&surface_lost="), "UTF-8")
+    }
+
+    // --- the flag ---------------------------------------------------------------------------------------------------
+
+    @Test
+    fun theFlagIsOffUnlessOneOrABoundInRange() {
+        assertNull(SurfaceHoldFlag.parse(null))
+        assertNull(SurfaceHoldFlag.parse(""))
+        assertNull(SurfaceHoldFlag.parse("0"))
+        assertNull(SurfaceHoldFlag.parse("yes"))
+        assertNull(SurfaceHoldFlag.parse("9999"))
+        assertNull(SurfaceHoldFlag.parse("30001"))
+        assertEquals(12_000L, SurfaceHoldFlag.parse("1"))
+        assertEquals(12_000L, SurfaceHoldFlag.parse(" 1 "))
+        assertEquals(20_000L, SurfaceHoldFlag.parse("20000"))
+        assertNull(SurfaceHoldFlag.fromSystem())   // no SystemProperties on the JVM: off
+    }
+
+    // --- the 3-s loss: one session -----------------------------------------------------------------------------------
+
+    @Test
+    fun aThreeSecondLossIsOneSessionTheSenderNeverStops() {
+        val up = Uplink()
+        val vPort = freePort()
+        val w = Wire(vPort)
+        val hold = SurfaceHold(SurfaceHoldFlag.DEFAULT_BOUND_MS)
+        val g = RestartGuard().also { it.attach(FilePendingStore(File(dir, "a.properties")), 1L, 1L) }
+        val a = ActivityModel(hold, g, up.socket.localPort, vPort)
+        a.startSession("surface-1")
+        repeat(15) { w.au(it % 15 == 0) }
+        Thread.sleep(50)
+        assertNotNull(a.decoder)
+        val senderBefore = a.sender
+        hold.onPause()
+        Thread.sleep(200)
+        val lostAt = System.nanoTime() / 1_000_000L
+        a.surfaceDestroyed()
+        assertTrue(hold.holding)
+        assertNull(a.decoder)
+        // through the hold: the stream keeps arriving, nothing decodes
+        val auBefore = a.accessUnits.size
+        repeat(30) { w.au(false); Thread.sleep(30) }
+        assertTrue(a.accessUnits.size > auBefore)
+        assertNull(a.decoder)
+        Thread.sleep(3_000L - (System.nanoTime() / 1_000_000L - lostAt))
+        a.surfaceCreated("surface-2")
+        val backAt = System.nanoTime() / 1_000_000L
+        assertFalse(hold.holding)
+        assertTrue(a.sessionStarted)
+        assertTrue(senderBefore === a.sender)
+        // the next IDR builds the decoder on the new surface; its first frame ends the synthetic age
+        w.au(true); Thread.sleep(30)
+        assertEquals("surface-2", a.decoder?.surface)
+        hold.stallAgeMs(System.nanoTime() / 1_000_000L, a.decoder!!.rendered)
+        Thread.sleep(100)
+        val end = System.nanoTime() / 1_000_000L
+        assertEquals(listOf("start"), a.posts)                       // one session: no second start
+        assertTrue("uplink gap ${up.maxGapMs(lostAt - 200, end)}", up.maxGapMs(lostAt - 200, end) < 100L)
+        // the stall signal: stalls during the hold, then one stall_end at the picture's return
+        val kinds = synchronized(up.stalls) { up.stalls.toList() }
+        assertTrue(kinds.count { it == StallPacket.KIND_STALL } >= 20)
+        assertEquals(StallPacket.KIND_END, kinds.last())
+        assertNull(g.takePending())                                   // the guard never saw a loss
+        val row = decodeRow(hold.query())
+        assertTrue(row, row.contains("\"outcome\":\"held\""))
+        val away = Regex("\"away_ms\":(\\d+)").find(row)!!.groupValues[1].toLong()
+        assertTrue("away $away", away in 2_900L..3_300L)
+        assertTrue(row, row.contains("\"bound_ms\":12000"))
+        assertTrue(row, Regex("\"paused_before_ms\":(\\d+)").find(row)!!.groupValues[1].toLong() >= 150L)
+        assertTrue(row, Regex("\"first_frame_ms\":(\\d+)").find(row)!!.groupValues[1].toLong() in 0L..(end - backAt))
+        assertEquals("", hold.query())
+        val f = hold.reportFields()
+        assertEquals(1L, f["losses"]); assertEquals(1L, f["held"]); assertEquals(0L, f["restarted"])
+        assertEquals(2L, f["decoders_built"]); assertEquals(15L, f["rendered_before_reattach"])
+        a.stopLocalPipeline(); w.close(); up.close()
+    }
+
+    // --- the 15-s loss: today's restart --------------------------------------------------------------------------------
+
+    @Test
+    fun aFifteenSecondLossIsTodaysRestart() {
+        val clock = longArrayOf(100_000L)
+        val up = Uplink()
+        val vPort = freePort()
+        val w = Wire(vPort)
+        val hold = SurfaceHold(SurfaceHoldFlag.DEFAULT_BOUND_MS) { clock[0] }
+        val g = RestartGuard { clock[0] }.also { it.attach(FilePendingStore(File(dir, "b.properties")), 1L, 1L) }
+        val a = ActivityModel(hold, g, up.socket.localPort, vPort)
+        a.startSession("surface-1")
+        repeat(3) { w.au(it == 0) }
+        a.surfaceDestroyed()
+        clock[0] += 11_900L
+        a.expiry()
+        assertTrue(hold.holding)                                       // not yet
+        clock[0] += 100L
+        a.expiry()                                                     // the bound: today's surface-loss path
+        assertFalse(hold.holding)
+        assertFalse(a.sessionStarted)
+        assertNull(a.sender)
+        clock[0] += 3_000L
+        a.surfaceCreated("surface-2")                                  // 15 s after the loss
+        assertEquals(listOf("start", "start&guard_end=1"), a.posts)
+        assertEquals("surface", g.lastCause!!["trigger"])
+        val row = decodeRow(hold.query())
+        assertTrue(row, row.contains("\"outcome\":\"restarted\""))
+        assertTrue(row, row.contains("\"away_ms\":12000"))
+        assertEquals(1L, hold.reportFields()["restarted"])
+        a.stopLocalPipeline(); w.close(); up.close()
+    }
+
+    // --- absent = today -----------------------------------------------------------------------------------------------
+
+    @Test
+    fun absentAThreeSecondLossIsTodaysRestart() {
+        val up = Uplink()
+        val vPort = freePort()
+        val w = Wire(vPort)
+        val clock = longArrayOf(5_000L)
+        val g = RestartGuard { clock[0] }.also { it.attach(FilePendingStore(File(dir, "c.properties")), 1L, 1L) }
+        val a = ActivityModel(null, g, up.socket.localPort, vPort)
+        a.startSession("surface-1")
+        val lostAt = System.nanoTime() / 1_000_000L
+        a.surfaceDestroyed()
+        assertNull(a.sender)                                           // today: the sender stops with the surface
+        Thread.sleep(300)
+        clock[0] += 3_000L
+        a.surfaceCreated("surface-2")
+        assertEquals(listOf("start", "start&guard_end=1"), a.posts)
+        assertEquals(3_000L, g.lastCause!!["away_ms"])
+        assertTrue(up.maxGapMs(lostAt, lostAt + 290) > 250L)
+        a.stopLocalPipeline(); w.close(); up.close()
+    }
+
+    // --- the keys --------------------------------------------------------------------------------------------------
+
+    @Test
+    fun aPadSystemKeyIsConsumedTheRemotesIsNot() {
+        val clock = longArrayOf(1_000L)
+        val h = SurfaceHold(12_000L) { clock[0] }
+        val pad = SurfaceHold.SOURCE_GAMEPAD or SurfaceHold.SOURCE_JOYSTICK
+        val remote = SurfaceHold.SOURCE_KEYBOARD or SurfaceHold.SOURCE_DPAD
+        assertTrue(h.onKey(SurfaceHold.KEYCODE_BUTTON_MODE, true, pad))
+        assertTrue(h.onKey(SurfaceHold.KEYCODE_BUTTON_MODE, false, pad))
+        assertFalse(h.onKey(SurfaceHold.KEYCODE_BUTTON_MODE, true, remote))
+        assertFalse(h.onKey(SurfaceHold.KEYCODE_HOME, true, remote))
+        assertFalse(h.onKey(96 /* BUTTON_A */, true, pad))
+        assertFalse(h.onKey(4 /* BACK */, true, pad))
+        assertEquals(1L, h.reportFields()["pad_system_keys_consumed"])
+        assertEquals(2L, h.reportFields()["system_keys_passed"])
+        clock[0] += 500L
+        h.onSurfaceLost(20L, true)
+        clock[0] += 1_000L
+        assertTrue(h.onSurfaceBack())
+        h.stallAgeMs(clock[0], 1L)
+        val row = decodeRow(h.query())
+        assertTrue(row, row.contains("\"reason\":\"pad_system_key\""))
+        assertTrue(row, row.contains("\"keys\":[\"110:pad:c\",\"110:remote:p\",\"3:remote:p\",\"96:pad:p\",\"4:pad:p\"]"))
+    }
+
+    @Test
+    fun theReasonOrder() {
+        val clock = longArrayOf(1_000L)
+        fun loss(setup: (SurfaceHold) -> Unit, interactive: Boolean? = true): String {
+            val h = SurfaceHold(12_000L) { clock[0] }
+            setup(h)
+            clock[0] += 300L
+            h.onSurfaceLost(0L, interactive)
+            clock[0] += 50_000L
+            h.onExpired()
+            return Regex("\"reason\":\"(\\w+)\"").find(decodeRow(h.query()))!!.groupValues[1]
+        }
+        assertEquals("remote_system_key", loss({ it.onKey(SurfaceHold.KEYCODE_SETTINGS, true, SurfaceHold.SOURCE_DPAD) }))
+        assertEquals("user_leave", loss({ it.onUserLeave(); it.onFocus(false) }))
+        assertEquals("screen_off", loss({ it.onFocus(false) }, false))
+        assertEquals("input_device", loss({ it.onDevice("removed", 0); it.onTopResumed(false) }))
+        assertEquals("top_lost", loss({ it.onTopResumed(false); it.onFocus(false) }))
+        assertEquals("focus_lost", loss({ it.onFocus(false) }))
+        assertEquals("unknown", loss({ it.onKey(96, true, SurfaceHold.SOURCE_GAMEPAD) }))
+        // a key older than the 2-s window is not the cause
+        assertEquals("unknown", loss({ it.onKey(SurfaceHold.KEYCODE_BUTTON_MODE, true, SurfaceHold.SOURCE_GAMEPAD); clock[0] += 2_500L }))
+    }
+
+    @Test
+    fun theRowIsBoundedAndHoldsNoFreeText() {
+        val clock = longArrayOf(1_000L)
+        val h = SurfaceHold(12_000L) { clock[0] }
+        repeat(10) {
+            repeat(12) { h.onKey(SurfaceHold.KEYCODE_MENU, true, SurfaceHold.SOURCE_DPAD) }
+            repeat(6) { h.onDevice("changed", SurfaceHold.SOURCE_GAMEPAD) }
+            h.onSurfaceLost(0L, null)
+            clock[0] += 20_000L
+            h.onExpired()
+        }
+        assertEquals(8, h.pendingRows().size)
+        assertEquals(2L, h.reportFields()["rows_dropped"])
+        val row = decodeRow(h.query())
+        assertTrue(row, row.startsWith("{\"seq\":3,"))
+        assertTrue(row.length <= SurfaceHold.MAX_ROW_CHARS)
+        assertEquals(8, Regex("\"82:remote:p\"").findAll(row).count())
+        assertEquals(4, Regex("\"changed:pad:\\d+\"").findAll(row).count())
+        assertTrue(row, row.contains("\"interactive\":null"))
+        assertEquals("{\"a\":\"xy\",\"b\":[1,true]}", h.encode(linkedMapOf("a" to "x\"y", "b" to listOf(1, true))))
+    }
+
+    @Test
+    fun theSenderNeutralizeKeepsItRunning() {
+        val up = Uplink()
+        val s = NativeControllerSender("127.0.0.1", up.socket.localPort)
+        s.start()
+        Thread.sleep(100)
+        val at = System.nanoTime() / 1_000_000L
+        s.neutralize()
+        Thread.sleep(200)
+        val n0 = s.snapshot().packetsSent
+        Thread.sleep(100)
+        assertTrue(s.snapshot().packetsSent > n0)
+        assertTrue(up.maxGapMs(at, at + 290) < 100L)
+        assertEquals(0, s.snapshot().lx)
+        s.stop(); up.close()
+    }
+}
diff --git a/tests/surface_lost/test_surface_lost.py b/tests/surface_lost/test_surface_lost.py
new file mode 100644
index 0000000000000000000000000000000000000000..3d85ebb4fb6029abdc8b1649bb6006a06c224f39
--- /dev/null
+++ b/tests/surface_lost/test_surface_lost.py
@@ -0,0 +1,149 @@
+#!/usr/bin/env python3
+"""B32: the client's `surface_lost` row, host side.
+
+    python3 -m unittest discover -s tests/surface_lost -v
+
+The real parser and the real LinkDropRecovery writing its recovery log in a temp root; the real heartbeat handler's
+block run from games.py's own source (its AST), with a fake recovery; no key = nothing imported (a fresh process).
+"""
+
+from __future__ import annotations
+
+import ast
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "companion"))
+
+import surface_lost_row as slr  # noqa: E402
+from games import link_drop_recovery as ldr  # noqa: E402
+
+HELD = ('{"seq":1,"reason":"pad_system_key","bound_ms":12000,"paused_before_ms":1720,"focus_lost_before_ms":1730,'
+        '"top_lost_before_ms":-1,"user_leave":false,"interactive":true,"keys":["110:pad:c","96:pad:p"],'
+        '"devices":["removed:pad:400"],"outcome":"held","away_ms":2027,"first_frame_ms":180}')
+
+
+class FakeRecovery:
+    def __init__(self):
+        self.rows = []
+
+    def _log(self, event, **fields):
+        self.rows.append({"event": event, **fields})
+
+
+def _recovery(root: Path) -> ldr.LinkDropRecovery:
+    import inspect
+    sig = inspect.signature(ldr.LinkDropRecovery.__init__)
+    kwargs = {}
+    for name, p in sig.parameters.items():
+        if name == "self":
+            continue
+        if name == "project_root":
+            kwargs[name] = root
+        elif p.default is inspect.Parameter.empty:
+            kwargs[name] = (lambda *a, **k: None)
+    return ldr.LinkDropRecovery(**kwargs)
+
+
+class Parse(unittest.TestCase):
+    def test_the_held_row_whole(self):
+        row = slr.parse(HELD)
+        self.assertEqual(row["outcome"], "held")
+        self.assertEqual(row["reason"], "pad_system_key")
+        self.assertEqual(row["away_ms"], 2027)
+        self.assertEqual(row["keys"], ["110:pad:c", "96:pad:p"])
+        self.assertEqual(row["devices"], ["removed:pad:400"])
+        self.assertIs(row["interactive"], True)
+        self.assertEqual(row["first_frame_ms"], 180)
+
+    def test_junk_and_overlong_give_nothing(self):
+        for raw in (None, "", "x", "[]", '{"outcome":"bogus"}', '{"reason":"unknown"}', "{" + "a" * 1100 + "}"):
+            self.assertIsNone(slr.parse(raw), raw)
+
+    def test_unknown_keys_text_and_bad_values_dropped(self):
+        addr = ".".join(str(x) for x in (10, 0, 0, 1))      # an address-shaped value, built from integers
+        row = slr.parse('{"outcome":"restarted","reason":"a name","away_ms":"12","note":"' + addr + '",'
+                        '"keys":["110:pad:c","ssid:pad:c",5],"devices":["added:pad:x"],"user_leave":"yes"}')
+        self.assertEqual(row["reason"], "unknown")
+        self.assertNotIn("away_ms", row)
+        self.assertNotIn("note", row)
+        self.assertNotIn("user_leave", row)
+        self.assertEqual(row["keys"], ["110:pad:c"])
+        self.assertEqual(row["devices"], [])
+        self.assertNotIn(addr, json.dumps(row))
+
+
+class Written(unittest.TestCase):
+    def test_one_recovery_row_in_the_real_log(self):
+        with tempfile.TemporaryDirectory() as d:
+            rec = _recovery(Path(d))
+            self.assertTrue(slr.note(rec, HELD, 41))
+            self.assertFalse(slr.note(rec, "junk", 42))
+            lines = [json.loads(x) for x in rec.log_path().read_text().splitlines()]
+            self.assertEqual(len(lines), 1)
+            r = lines[0]
+            self.assertEqual(r["event"], "surface_lost")
+            self.assertEqual(r["heartbeat_sequence"], 41)
+            self.assertEqual(r["outcome"], "held")
+            self.assertEqual(r["away_ms"], 2027)
+
+
+class TheHandlerBlock(unittest.TestCase):
+    """games.py's own `if "surface_lost" in query:` block, run as written with a fake recovery."""
+
+    def _block(self) -> ast.If:
+        tree = ast.parse((ROOT / "companion" / "plugins" / "games.py").read_text())
+        found = [n for n in ast.walk(tree) if isinstance(n, ast.If) and ast.unparse(n.test) == "'surface_lost' in query"]
+        self.assertEqual(len(found), 1)
+        return found[0]
+
+    def _run(self, query: dict) -> list:
+        class Self:
+            _recovery = FakeRecovery()
+
+            @staticmethod
+            def _first(q, key, default=""):
+                v = q.get(key)
+                return v[0] if v else default
+        me = Self()
+        code = compile(ast.Module(body=[self._block()], type_ignores=[]), "games_block", "exec")
+        exec(code, {}, {"query": query, "self": me, "values": {"sequence": 7}})
+        return me._recovery.rows
+
+    def test_the_key_one_row(self):
+        rows = self._run({"surface_lost": [HELD], "sequence": ["7"]})
+        self.assertEqual(len(rows), 1)
+        self.assertEqual(rows[0]["event"], "surface_lost")
+        self.assertEqual(rows[0]["heartbeat_sequence"], 7)
+
+    def test_no_key_no_row(self):
+        self.assertEqual(self._run({"sequence": ["7"]}), [])
+
+    def test_the_block_sits_after_the_heartbeat_is_written(self):
+        src = (ROOT / "companion" / "plugins" / "games.py").read_text()
+        self.assertLess(src.index("result = append_native_stream_heartbeat("), src.index('if "surface_lost" in query:'))
+        self.assertEqual(src.count("surface_lost_row"), 3)   # the import (twice) and the call
+
+
+class Absent(unittest.TestCase):
+    def test_a_fresh_process_imports_nothing(self):
+        env = {k: v for k, v in os.environ.items() if not k.startswith("PRIVYHUB_")}
+        code = ("import sys; sys.path.insert(0, 'companion'); import plugins.games; "
+                "print('surface_lost_row' in sys.modules)")
+        out = subprocess.run([sys.executable, "-B", "-c", code], cwd=ROOT, env=env, capture_output=True, text=True,
+                             timeout=120)
+        self.assertEqual(out.stdout.strip().splitlines()[-1:], ["False"], out.stderr[-800:])
+
+    def test_the_heartbeat_whitelist_is_unchanged(self):
+        src = (ROOT / "companion" / "games" / "native_stream_heartbeat.py").read_text()
+        self.assertNotIn("surface_lost", src)
+
+
+if __name__ == "__main__":
+    unittest.main()
