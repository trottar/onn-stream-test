+        self.assertIn("interrupted before: resumed", out)
+        self.assertEqual(self.listed(t, on=True), [("ps1", "Alpha Quest"), ("ps1", "Beta Racer"),
+                                                   ("ps1", "Gamma Saga")])
+        self.assertFalse(iu.journal_path(t.hub).exists())
