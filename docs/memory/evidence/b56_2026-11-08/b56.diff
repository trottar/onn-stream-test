+        chd(t.games / "Gap" / "Gap (Disc 1).chd", 5)
+        chd(t.games / "Gap" / "Gap (Disc 3).chd", 6)
+        st = iu.scan_stick(iu.find_root(t.stick))
+        kinds = {c["title"]: (c["kind"], c["error"]) for c in st["candidates"]}
+        self.assertEqual(kinds["Alpha Quest"], ("chd", None))
