+        (t.games / "._Alpha Quest.chd").write_bytes(b"x")         # a hidden helper file: ignored
+        (t.games / "Link.chd").symlink_to(t.base)
+        cue(t.games / "Missing.cue", ["Missing (Track 1).bin"])
+        bin_track(t.games / "case" / "case (track 1).bin", 9)
