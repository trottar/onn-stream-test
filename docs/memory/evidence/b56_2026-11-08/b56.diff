+        self.assertEqual(kinds["Gap"], ("m3u_set", "multidisc_gap"))
+        rej = sorted((Path(r["source"]).name, r["reason"]) for r in st["rejected"])
+        self.assertIn(("Lonely.bin", "bin_without_cue"), rej)
+        self.assertIn(("Notes.txt", "unknown_type"), rej)
