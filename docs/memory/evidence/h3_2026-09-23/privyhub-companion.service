# PrivyHub companion — systemd USER unit (design H3, 2026-09-23; NOT installed).
# Install: see docs/memory/evidence/H3_COMPANION_AUTOSTART_DESIGN_2026-09-23.md
[Unit]
Description=PrivyHub companion (control API :8765, native game stream)
# Ordering only: the managed PulseAudio sink is created per stream start.
After=pulseaudio.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/onn-stream-test
# The only variable the companion needs (_linux_display reads DISPLAY and
# nothing else). No PRIVYHUB_* diagnostic variable is ever set here.
Environment=DISPLAY=:0
Environment=PYTHONUNBUFFERED=1
# XFCE never activates graphical-session.target on this host, so the unit
# hangs off default.target and waits, bounded, for X on :0 to answer.
ExecStartPre=/bin/sh -c 'i=0; while [ "$i" -lt 60 ]; do xrandr --current >/dev/null 2>&1 && exit 0; i=$((i+1)); sleep 1; done; echo "X on :0 did not answer within 60 s" >&2; exit 1'
ExecStart=/usr/bin/python3 -u ./companion/privyhub_service.py
# The companion shuts down cleanly (plugin shutdown: SAVE_FILES, RetroArch
# closed) only on SIGINT/KeyboardInterrupt; SIGTERM would orphan a game.
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=20
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
