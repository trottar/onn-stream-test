+    gs = {"Renderer": "14", "upscale_multiplier": "1"}
+    for k in ("OsdShowSpeed", "OsdShowFPS", "OsdShowVPS", "OsdShowCPU", "OsdShowGPU", "OsdShowResolution"):
+        gs[k] = "false"
+    if adapter:
