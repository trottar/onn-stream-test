+        self.assertTrue(ps2.enabled({"PRIVYHUB_PS2": "1"}))
+        for v in (None, "", "0", "true", "yes"):
+            self.assertFalse(ps2.enabled({} if v is None else {"PRIVYHUB_PS2": v}))
