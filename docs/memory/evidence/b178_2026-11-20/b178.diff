+def kept_rules_digest() -> list:
+    folder = Path.home() / "privyhub_h7" / "rules"
+    if not folder.is_dir():
+        return []
+    return sorted(hashlib.sha256(p.read_bytes()).hexdigest() for p in folder.iterdir() if p.is_file())
