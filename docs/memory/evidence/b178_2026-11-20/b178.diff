+
+
+def _gap_ok(prev, nxt) -> bool:
+    h = prev[2] - prev[0] + 1
+    return -SCORE_TOL <= nxt[1] - prev[3] - 1 <= max(4, 0.6 * h)
+
+
+_STRINGS: dict = {}
