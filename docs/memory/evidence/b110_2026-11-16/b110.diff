+class FlagsAbsentAreToday(unittest.TestCase):
+    def test_each_flag_absent(self):
+        old = b99.BASELINE
+        b99.BASELINE = BASELINE
+        try:
+            code = b99.head_code()
+        finally:
+            b99.BASELINE = old
+        if code is None:
+            self.skipTest("git is absent")
+        for env in ({**b85.FLAGS, "PRIVYHUB_PARTY": "1"}, {**b85.FLAGS, "PRIVYHUB_H7": "1"}, b85.FLAGS,
