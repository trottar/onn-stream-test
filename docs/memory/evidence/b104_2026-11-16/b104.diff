+        (folder / "labels.json").write_text(json.dumps({"classes": CLASSES, "runs": {"replay_run": ranges}}))
+        for k, after in ((3, 2.0), (2, 1.0)):
+            out = E.replay(folder, self.spec, self.arrays, k=k, labels=folder / "labels.json")
