+        elif m_more:
+            extra[stem] = (p, f"end_P{m_more.group(1)}")
+        elif re.match(r"^results_[0-9]+$", stem):
+            results.append(p)
+        else:
+            unused.append(p.name)
+    return {"roles": roles, "extra": extra, "results": results, "unused": unused}
