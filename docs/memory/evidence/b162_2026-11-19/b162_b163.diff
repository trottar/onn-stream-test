+    for t, f in rows:
+        now[0] = t
+        with Image.open(run / f) as im:
+            r = reader.read(im.convert("L"), now=t)
+        done = ended.feed(r["class"], r.get("places"))
+        if done:
+            return [done, list(ended.places) if ended.places else None]
+    return None
