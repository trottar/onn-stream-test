+        self.assertEqual((d["last_stepup_dt_s"], d["last_stepup_in_session"]), (120, True))
+        self.assertEqual((d["trigger"], d["paused_ms"], d["away_ms"]), ("surface", 1500, 2000))
+        self.assertEqual(d["surface_lost"][0]["keys"], ["BUTTON_MODE"])
