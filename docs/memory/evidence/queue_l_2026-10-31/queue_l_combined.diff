+
+/**
+ * B35: the Android side of [VodRetryController] -- the main-thread scheduler, the "reconnecting…" mark on the
+ * player's overlay, the Retry dialog, and the rows posted to the hub (`POST /diagnostics/vod-client`, JSON, the
+ * session header as every control call; every failure ignored). Built by MainActivity only when
+ * `debug.privyhub.vod_retry=1` and the playback is not live.
+ */
+class VodRetryAndroid(
+    private val activity: Activity,
+    private val playerView: PlayerView,
+    sourceId: String,
+    private val rowsUrl: () -> String,
+    private val currentPlayer: () -> ExoPlayer?,
+) {
+    private val handler = Handler(Looper.getMainLooper())
+    private var pending: Runnable? = null
+    private var mark: TextView? = null
+
+    private val controller = VodRetryController(
+        policy = VodRetryPolicy(),
+        player = object : VodRetryController.Player {
+            override fun retryAt(positionMs: Long) {
+                val p = currentPlayer() ?: return
+                p.seekTo(positionMs)
+                p.prepare()
+                p.playWhenReady = true
+            }
+        },
+        scheduler = object : VodRetryController.Scheduler {
+            override fun schedule(delayMs: Long, task: () -> Unit) {
+                val r = Runnable {
+                    pending = null
+                    task()
+                }
+                pending = r
+                handler.postDelayed(r, delayMs)
+            }
+
+            override fun cancel() {
+                pending?.let { handler.removeCallbacks(it) }
+                pending = null
+            }
+        },
+        clock = { SystemClock.elapsedRealtime() },
+        rows = { post(it) },
+        ui = object : VodRetryController.Ui {
+            override fun showMark(attempt: Int) = show()
+            override fun hideMark() = hide()
+            override fun offerRetry() = dialog()
+        },
+        sourceId = sourceId,
+    )
+
+    fun onError(error: PlaybackException, positionMs: Long): Boolean =
+        controller.onError(error.errorCode, error.errorCodeName, positionMs)
+
+    fun afterTodaysError() = controller.afterTodaysError()
+
+    fun onReady() = controller.onReady()
+
+    fun cancel() = controller.cancel()
+
+    private fun show() {
+        if (mark != null) {
+            return
+        }
+        val frame = playerView.overlayFrameLayout ?: return
+        val view = TextView(activity).apply {
+            text = "reconnecting…"
+            textSize = 14f
+            setTextColor(Color.WHITE)
+            setBackgroundColor(Color.argb(140, 0, 0, 0))
+            setPadding(16, 8, 16, 8)
+        }
+        frame.addView(
+            view,
+            FrameLayout.LayoutParams(
+                FrameLayout.LayoutParams.WRAP_CONTENT,
+                FrameLayout.LayoutParams.WRAP_CONTENT,
+                Gravity.TOP or Gravity.END
+            ).apply { setMargins(0, 24, 24, 0) }
+        )
+        mark = view
+    }
+
+    private fun hide() {
+        val view = mark ?: return
+        (view.parent as? FrameLayout)?.removeView(view)
+        mark = null
+    }
+
+    private fun dialog() {
+        if (activity.isFinishing) {
+            return
+        }
+        AlertDialog.Builder(activity)
+            .setTitle("Playback error")
+            .setMessage("The connection to the hub was lost.")
+            .setPositiveButton("Retry") { _, _ -> controller.manualRetry() }
+            .setNegativeButton("Close", null)
+            .show()
+    }
+
+    private fun post(row: Map<String, Any>) {
+        val url = try {
+            rowsUrl()
+        } catch (_: Exception) {
+            return
+        }
+        val body = JSONObject(row).toString().toByteArray(Charsets.UTF_8)
+        thread(start = true, isDaemon = true, name = "PrivyHub-VodRetry-Row") {
+            try {
+                val c = (URL(url).openConnection() as HttpURLConnection).apply {
+                    requestMethod = "POST"
+                    connectTimeout = 1_500
+                    readTimeout = 1_500
+                    doOutput = true
+                    setRequestProperty("Content-Type", "application/json")
+                    setFixedLengthStreamingMode(body.size)
+                }
+                PrivyHubIdentity.decorate(activity, c, url)
+                c.outputStream.use { it.write(body) }
+                c.responseCode
+                c.disconnect()
+            } catch (_: Exception) {
+                // a diagnostic row must never disturb playback
+            }
+        }
+    }
+}
diff --git a/PrivyHub/app/src/main/java/vod/VodRetry.kt b/PrivyHub/app/src/main/java/vod/VodRetry.kt
new file mode 100644
index 0000000000000000000000000000000000000000..11a4cdf2dad0984bd1b924e3664cf3e11b35dc05
--- /dev/null
+++ b/PrivyHub/app/src/main/java/vod/VodRetry.kt
@@ -0,0 +1,176 @@
+package com.safeiot.privyhub.vod
+
+import java.security.MessageDigest
+
+/**
+ * B35: the movie player retries by itself. Behind `debug.privyhub.vod_retry=1` (CL-B7P's convention; a reboot
+ * clears it). Absent / empty / `0` / junk = today: no controller, so MainActivity's `vodRetry?.` calls are no-ops and
+ * a load / IO error shows today's "Playback error" at once.
+ *
+ * With the flag, on a retryable load / IO error during VOD (not live) playback: reconnect, seek to the position of
+ * the episode's first error, resume -- backoff [BACKOFF_MS] then 15 s each, for up to [BOUND_MS] from the first
+ * error; a small "reconnecting…" mark meanwhile; past the bound today's error plus a Retry button. Each step is a row
+ * to the host (`vod_error` / `vod_retry` / `vod_resumed` / `vod_gave_up`); no title, path or URL in any row.
+ *
+ * Pure Kotlin (no Android type) so the JVM tests drive it with a fake clock, scheduler and player.
+ */
+object VodRetryFlag {
+    const val PROPERTY = "debug.privyhub.vod_retry"
+
+    fun parse(raw: String?): Boolean = raw?.trim() == "1"
+
+    fun read(): Boolean =
+        try {
+            val get = Class.forName("android.os.SystemProperties").getMethod("get", String::class.java)
+            parse(get.invoke(null, PROPERTY) as? String)
+        } catch (_: Throwable) {
+            false
+        }
+}
+
+class VodRetryPolicy(
+    val backoffMs: LongArray = BACKOFF_MS,
+    val boundMs: Long = BOUND_MS,
+) {
+    /** The delay before attempt [attempt] (1-based): 1, 2, 4, 8, 15 s, then 15 s each. */
+    fun delayBefore(attempt: Int): Long = backoffMs[(attempt - 1).coerceIn(0, backoffMs.size - 1)]
+
+    companion object {
+        val BACKOFF_MS = longArrayOf(1_000L, 2_000L, 4_000L, 8_000L, 15_000L)
+        const val BOUND_MS = 150_000L
+
+        /** Media3 codes: TIMEOUT 1003; IO 2000 unspecified, 2001 connection failed, 2002 timeout, 2004 bad status. */
+        val RETRYABLE = setOf(1003, 2000, 2001, 2002, 2004)
+
+        fun isRetryable(code: Int): Boolean = code in RETRYABLE
+    }
+}
+
+class VodRetryController(
+    private val policy: VodRetryPolicy,
+    private val player: Player,
+    private val scheduler: Scheduler,
+    private val clock: () -> Long,
+    private val rows: (Map<String, Any>) -> Unit,
+    private val ui: Ui,
+    sourceId: String,
+) {
+    interface Player {
+        /** Reconnect and resume at [positionMs] (Media3: seekTo, prepare, playWhenReady). */
+        fun retryAt(positionMs: Long)
+    }
+
+    interface Scheduler {
+        fun schedule(delayMs: Long, task: () -> Unit)
+        fun cancel()
+    }
+
+    interface Ui {
+        fun showMark(attempt: Int)
+        fun hideMark()
+        fun offerRetry()
+    }
+
+    val media: String = opaqueId(sourceId)
+
+    private var firstErrorAtMs = -1L
+    private var positionMs = 0L
+    private var attempts = 0
+    private var lastCode = 0
+    private var lastName = ""
+    private var gaveUp = false
+    private var cancelled = false
+
+    val retrying: Boolean get() = firstErrorAtMs >= 0 && !gaveUp
+
+    /** True = handled (an attempt is scheduled); false = today's error path runs now. */
+    fun onError(code: Int, codeName: String, currentPositionMs: Long): Boolean {
+        if (cancelled || !VodRetryPolicy.isRetryable(code)) {
+            return false
+        }
+        val now = clock()
+        lastCode = code
+        lastName = codeName
+        if (firstErrorAtMs < 0 || gaveUp) {
+            firstErrorAtMs = now
+            positionMs = currentPositionMs.coerceAtLeast(0L)
+            attempts = 0
+            gaveUp = false
+            rows(row("vod_error") + mapOf("error_code" to code, "error_name" to codeName))
+        }
+        val next = attempts + 1
+        val delay = policy.delayBefore(next)
+        val elapsed = now - firstErrorAtMs
+        if (elapsed + delay > policy.boundMs) {
+            gaveUp = true
+            scheduler.cancel()
+            ui.hideMark()
+            rows(row("vod_gave_up") + mapOf("attempts" to attempts, "elapsed_ms" to elapsed,
+                "error_code" to code, "error_name" to codeName))
+            return false
+        }
+        attempts = next
+        rows(row("vod_retry") + mapOf("attempt" to next, "delay_ms" to delay, "elapsed_ms" to elapsed,
+            "error_code" to code, "error_name" to codeName))
+        ui.showMark(next)
+        scheduler.cancel()
+        scheduler.schedule(delay) {
+            if (!cancelled && retrying) {
+                player.retryAt(positionMs)
+            }
+        }
+        return true
+    }
+
+    /** After today's error branch ran: past the bound, offer Retry (new, flag only). */
+    fun afterTodaysError() {
+        if (gaveUp && !cancelled) {
+            ui.offerRetry()
+        }
+    }
+
+    /** The player is READY: an open episode closes. */
+    fun onReady() {
+        if (firstErrorAtMs < 0 || gaveUp || cancelled) {
+            return
+        }
+        rows(row("vod_resumed") + mapOf("attempts" to attempts, "elapsed_ms" to (clock() - firstErrorAtMs)))
+        ui.hideMark()
+        firstErrorAtMs = -1L
+        attempts = 0
+    }
+
+    /** The Retry button: a new episode at the saved position, the first attempt at once. */
+    fun manualRetry() {
+        if (cancelled) {
+            return
+        }
+        firstErrorAtMs = clock()
+        attempts = 1
+        gaveUp = false
+        rows(row("vod_retry") + mapOf("attempt" to 1, "delay_ms" to 0L, "elapsed_ms" to 0L,
+            "error_code" to lastCode, "error_name" to lastName))
+        ui.showMark(1)
+        player.retryAt(positionMs)
+    }
+
+    fun cancel() {
+        cancelled = true
+        scheduler.cancel()
+        ui.hideMark()
+    }
+
+    private fun row(event: String): Map<String, Any> =
+        mapOf("event" to event, "media" to media, "position_ms" to positionMs, "bound_ms" to policy.boundMs)
+
+    companion object {
+        fun opaqueId(sourceId: String): String =
+            MessageDigest.getInstance("SHA-256")
+                .digest(("privyhub-vod-source:" + sourceId).toByteArray(Charsets.UTF_8))
+                .take(6)
+                .joinToString("") { "%02x".format(it) }
+
+        /** As MainActivity builds it: only with the flag, only for VOD (never live). */
+        fun wanted(flag: Boolean, isLive: Boolean): Boolean = flag && !isLive
+    }
+}
diff --git a/PrivyHub/app/src/test/java/streaming/PadSlotsTest.kt b/PrivyHub/app/src/test/java/streaming/PadSlotsTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..71e108e04258e96e5e8015fe111fe394eaab7368
--- /dev/null
+++ b/PrivyHub/app/src/test/java/streaming/PadSlotsTest.kt
@@ -0,0 +1,129 @@
+package com.safeiot.privyhub.streaming
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * B34: stable player slots, gamepads only (debug.privyhub.pad_slots=stable). Fake devices; one PadSlots object plays
+ * the process-wide holder (PadSlotsProcess.slots) across starts and self-restarts.
+ */
+class PadSlotsTest {
+
+    private data class Fake(
+        override val descriptor: String,
+        override val controllerNumber: Int,
+        override val vendorId: Int = 0x054c,
+        override val productId: Int = 0x0268,
+        override val sources: Int = GAMEPAD or JOYSTICK,
+        override val hasGamepadButton: Boolean = true,
+        override val isVirtual: Boolean = false,
+    ) : PadDevice
+
+    companion object {
+        const val GAMEPAD = 0x00000401
+        const val JOYSTICK = 0x01000010
+        const val KEYBOARD = 0x00000101
+        const val DPAD = 0x00000201
+        const val MOUSE = 0x00002002
+    }
+
+    private val padA = Fake("descriptor-of-pad-a-0123456789", controllerNumber = 1)
+    private val padB = Fake("descriptor-of-pad-b-9876543210", controllerNumber = 2)
+    private val padC = Fake("descriptor-of-pad-c", controllerNumber = 3, vendorId = 0x045e)
+    // the onn's remote: keyboard + dpad, no gamepad source, no gamepad button
+    private val remote = Fake("remote", 0, vendorId = 0x0957, sources = KEYBOARD or DPAD, hasGamepadButton = false)
+    // an air mouse / a pad's motion device: joystick axes, no gamepad button
+    private val airMouse = Fake("air-mouse", 0, vendorId = 0x1d5a, sources = JOYSTICK or MOUSE, hasGamepadButton = false)
+
+    private fun slotsAfter(connected: List<PadDevice>, pressOrder: List<PadDevice>): List<Int?> {
+        val s = PadSlots()
+        s.beginStart(connected)
+        return pressOrder.map { s.slotFor(it) { connected } }
+    }
+
+    @Test
+    fun twoPadsGetTheSameSlotsWhicheverIsListedOrPressedFirst() {
+        val want = listOf(0, 1)   // A (controller 1) -> P1, B (controller 2) -> P2
+        for (listed in listOf(listOf(padA, padB), listOf(padB, padA))) {
+            assertEquals(want, slotsAfter(listed, listOf(padA, padB)))
+            assertEquals(want.reversed(), slotsAfter(listed, listOf(padB, padA)))
+        }
+    }
+
+    @Test
+    fun aRestartKeepsTheSlots() {
+        val s = PadSlots()
+        val both = listOf<PadDevice>(padA, padB)
+        s.beginStart(both)
+        assertEquals(1, s.slotFor(padB) { both })
+        val before = s.mapString()
+        // the self-restart: the same process object, a new start, B presses first this time
+        s.beginStart(listOf(padB, padA))
+        assertEquals(1, s.slotFor(padB) { both })
+        assertEquals(0, s.slotFor(padA) { both })
+        assertEquals(before, s.mapString())
+    }
+
+    @Test
+    fun aStickAxisRemoteAndAnAirMouseAreExcluded() {
+        val all = listOf(remote, airMouse, padB)
+        val s = PadSlots()
+        s.beginStart(all)
+        assertNull(s.slotFor(remote) { all })
+        assertNull(s.slotFor(airMouse) { all })
+        assertEquals(0, s.slotFor(padB) { all })   // the real pad is P1, not pushed to P2 / P3
+        assertEquals(1, s.map().size)
+        assertFalse(PadSlots.eligible(remote))
+        assertFalse(PadSlots.eligible(airMouse))
+        assertFalse(PadSlots.eligible(padA.copy(isVirtual = true)))
+        assertTrue(PadSlots.eligible(padA))
+    }
+
+    @Test
+    fun aLaterPadTakesTheLowestFreeSlotAndALeavingPadKeepsItsSlot() {
+        val s = PadSlots()
+        s.beginStart(listOf(padA, padB))
+        // A leaves; C joins: C takes slot 2 (the lowest free), A keeps 0
+        val now = listOf<PadDevice>(padB, padC)
+        assertEquals(2, s.slotFor(padC) { now })
+        s.beginStart(now)
+        assertEquals(listOf(0, 1, 2), s.map().map { it.slot })
+        // A comes back: still P1
+        assertEquals(0, s.slotFor(padA) { listOf(padA, padB, padC) })
+    }
+
+    @Test
+    fun aFifthPadGetsAGonePadsSlotOrNone() {
+        val pads = (1..5).map { Fake("pad-$it", it) }
+        val s = PadSlots()
+        s.beginStart(pads.take(4))
+        assertNull(s.slotFor(pads[4]) { pads })                         // all four connected: none, as today
+        val withoutSecond = pads.filter { it != pads[1] }
+        assertEquals(1, s.slotFor(pads[4]) { withoutSecond })            // the gone pad's slot
+        assertNull(s.map().firstOrNull { it.pad == PadSlots.key(pads[1]) })
+    }
+
+    @Test
+    fun theMapCarriesNoDescriptorOrName() {
+        val s = PadSlots()
+        s.beginStart(listOf(padA, padC))
+        val m = s.mapString()
+        assertTrue(m, Regex("^[0-3]:[0-9a-f]{6}:[a-z0-9]{2,12}(,[0-3]:[0-9a-f]{6}:[a-z0-9]{2,12}){0,3}$").matches(m))
+        assertFalse(m.contains("descriptor"))
+        assertEquals(listOf("sony", "microsoft"), s.map().map { it.cls })
+        assertEquals(6, PadSlots.key(padA).length)
+        assertEquals("", PadSlots().mapString())
+    }
+
+    @Test
+    fun theFlagIsStableOnly() {
+        assertTrue(PadSlotsFlag.parse("stable"))
+        assertTrue(PadSlotsFlag.parse(" stable "))
+        for (v in listOf(null, "", "1", "0", "Stable", "junk")) assertFalse(v.toString(), PadSlotsFlag.parse(v))
+        // off the device the property cannot be read: absent, today
+        assertFalse(PadSlotsFlag.fromSystem())
+    }
+}
diff --git a/PrivyHub/app/src/test/java/streaming/SurfaceHoldTest.kt b/PrivyHub/app/src/test/java/streaming/SurfaceHoldTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..1efed0faeef5504096e3fdbdb18572c66b857b8e
--- /dev/null
+++ b/PrivyHub/app/src/test/java/streaming/SurfaceHoldTest.kt
@@ -0,0 +1,394 @@
+package com.safeiot.privyhub.streaming
+
+import java.io.File
+import java.net.DatagramPacket
+import java.net.DatagramSocket
+import java.net.InetAddress
+import java.net.SocketTimeoutException
+import java.net.URLDecoder
+import java.nio.ByteBuffer
+import java.nio.file.Files
+import java.util.Collections
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * B32: the hold through a brief loss of the screen. B15's style: the activity's surface paths modelled as the activity
+ * calls them (`surfaceDestroyed` / `surfaceCreated` / the expiry / the parameter-set callback), against the real
+ * [SurfaceHold], the real [RestartGuard] with a file store, the real [RtpH264Receiver] on loopback, the real
+ * [NativeControllerSender] sending to a loopback socket, the real [StallMonitor], and a fake host counting starts.
+ */
+class SurfaceHoldTest {
+
+    private val dir: File = Files.createTempDirectory("b32_store_").toFile()
+
+    private fun freePort(): Int = DatagramSocket(0).use { it.localPort }
+
+    /** The controller's uplink as the host's socket sees it: arrival times of every datagram. */
+    private class Uplink {
+        val socket = DatagramSocket(0, InetAddress.getLoopbackAddress()).apply { soTimeout = 50 }
+        val arrivals: MutableList<Long> = Collections.synchronizedList(mutableListOf<Long>())
+        val stalls: MutableList<Int> = Collections.synchronizedList(mutableListOf<Int>())
+        @Volatile var running = true
+        private val t = Thread {
+            val buf = ByteArray(64)
+            while (running) {
+                val p = DatagramPacket(buf, buf.size)
+                try {
+                    socket.receive(p)
+                    arrivals.add(System.nanoTime() / 1_000_000L)
+                    if (p.length == StallPacket.SIZE && buf[0] == 'P'.code.toByte() && buf[2] == 'S'.code.toByte()) {
+                        stalls.add(buf[4].toInt())
+                    }
+                } catch (_: SocketTimeoutException) {
+                }
+            }
+        }.apply { isDaemon = true; start() }
+
+        fun maxGapMs(fromMs: Long, toMs: Long): Long {
+            val a = synchronized(arrivals) { arrivals.filter { it in fromMs..toMs }.sorted() }
+            if (a.isEmpty()) return Long.MAX_VALUE
+            var g = a.first() - fromMs
+            for (i in 1 until a.size) g = maxOf(g, a[i] - a[i - 1])
+            return maxOf(g, toMs - a.last())
+        }
+
+        fun close() { running = false; t.join(500); socket.close() }
+    }
+
+    private class Wire(val port: Int, var seq: Int = 100) {
+        private val tx = DatagramSocket()
+        private var ts = 90_000L
+        fun au(idr: Boolean) {
+            val nal = byteArrayOf(if (idr) 0x65 else 0x41, 0x11, 0x22, 0x33, 0x44)
+            val p = ByteBuffer.allocate(12 + nal.size)
+            p.put(0x80.toByte()).put((0x80 or 96).toByte()).putShort(seq.toShort()).putInt(ts.toInt()).putInt(0x1234)
+            p.put(nal)
+            seq = (seq + 1) and 0xffff
+            ts += 1500L
+            tx.send(DatagramPacket(p.array(), p.capacity(), InetAddress.getLoopbackAddress(), port))
+            Thread.sleep(3)
+        }
+        fun close() = tx.close()
+    }
+
+    /** A fake decoder: built only on a live surface; renders what it is given. */
+    private class FakeDecoder(val surface: String) {
+        var rendered = 0L
+    }
+
+    /**
+     * The activity's B32 paths with the hold (or, [hold] null, today's): the start, the surface's loss and return,
+     * the expiry, the parameter-set callback. Posts go to [posts].
+     */
+    private inner class ActivityModel(val hold: SurfaceHold?, val guard: RestartGuard?, uplinkPort: Int, videoPort: Int) {
+        val posts: MutableList<String> = Collections.synchronizedList(mutableListOf<String>())
+        var sessionStarted = false
+        var sender: NativeControllerSender? = null
+        var receiver: RtpH264Receiver? = null
+        @Volatile var decoder: FakeDecoder? = null
+        @Volatile var heldSurface: String? = null
+        val monitor = StallMonitor(150L)
+        val upPort = uplinkPort
+        val vPort = videoPort
+        val accessUnits = Collections.synchronizedList(mutableListOf<Int>())
+
+        fun stallInputs(nowMs: Long): StallInputs {
+            val i = StallInputs(outputAgeMs = if (decoder != null) 16L else -1L, renderedFrames = decoder?.rendered ?: 0L,
+                inGate = false, released = true)
+            return hold?.stallAgeMs(nowMs, i.renderedFrames)?.let { a -> i.copy(outputAgeMs = a) } ?: i
+        }
+
+        fun startSession(surface: String) {
+            if (sessionStarted) return
+            sessionStarted = true
+            heldSurface = surface
+            val restart = guard?.takePending()
+            restart?.let { p -> guard?.beginViaStart(p) }
+            posts.add(if (restart != null) "start&guard_end=1" else "start")
+            sender = NativeControllerSender("127.0.0.1", upPort).also { s ->
+                s.stallTick = { now -> monitor.tick(now, stallInputs(now)) }
+                s.start()
+            }
+            receiver = RtpH264Receiver(
+                port = vPort,
+                onParameterSets = { _, _ -> },
+                onAccessUnit = { _, _ ->
+                    accessUnits.add(1)
+                    // the parameter-set callback's rule: a decoder only on a live surface (the hold), or the closure's
+                    if (decoder == null) {
+                        val target = if (hold != null) heldSurface else surface
+                        if (target != null) { decoder = FakeDecoder(target); hold?.onDecoderBuilt() }
+                    }
+                    decoder?.let { it.rendered++ }
+                },
+            ).also { it.start() }
+            Thread.sleep(150)
+        }
+
+        fun surfaceDestroyed(finishing: Boolean = false) {
+            if (sessionStarted && !finishing && hold != null) {
+                hold.onSurfaceLost(16L, true)
+                sender?.neutralize()
+                heldSurface = null
+                decoder?.let { hold.onDecoderClosed(it.rendered) }
+                decoder = null
+                return
+            }
+            if (sessionStarted) guard?.onSurfaceLost("{\"r\":1}", 16L, 10L, false)
+            stopLocalPipeline()
+            sessionStarted = false
+        }
+
+        fun surfaceCreated(surface: String) {
+            if (hold != null && sessionStarted && hold.onSurfaceBack()) {
+                heldSurface = surface
+                return
+            }
+            startSession(surface)
+        }
+
+        fun expiry() {
+            val h = hold ?: return
+            if (!h.holding || !h.expired()) return
+            h.onExpired()
+            guard?.onSurfaceLost("{\"r\":1}", -1L, -1L, false)
+            stopLocalPipeline()
+            sessionStarted = false
+        }
+
+        fun stopLocalPipeline() {
+            sender?.stop(); sender = null
+            receiver?.stop(); receiver = null
+            decoder = null
+        }
+    }
+
+    private fun decodeRow(q: String): String {
+        assertTrue(q, q.startsWith("&surface_lost="))
+        return URLDecoder.decode(q.removePrefix("&surface_lost="), "UTF-8")
+    }
+
+    // --- the flag ---------------------------------------------------------------------------------------------------
+
+    @Test
+    fun theFlagIsOffUnlessOneOrABoundInRange() {
+        assertNull(SurfaceHoldFlag.parse(null))
+        assertNull(SurfaceHoldFlag.parse(""))
+        assertNull(SurfaceHoldFlag.parse("0"))
+        assertNull(SurfaceHoldFlag.parse("yes"))
+        assertNull(SurfaceHoldFlag.parse("9999"))
+        assertNull(SurfaceHoldFlag.parse("30001"))
+        assertEquals(12_000L, SurfaceHoldFlag.parse("1"))
+        assertEquals(12_000L, SurfaceHoldFlag.parse(" 1 "))
+        assertEquals(20_000L, SurfaceHoldFlag.parse("20000"))
+        assertNull(SurfaceHoldFlag.fromSystem())   // no SystemProperties on the JVM: off
+    }
+
+    // --- the 3-s loss: one session -----------------------------------------------------------------------------------
+
+    @Test
+    fun aThreeSecondLossIsOneSessionTheSenderNeverStops() {
+        val up = Uplink()
+        val vPort = freePort()
+        val w = Wire(vPort)
+        val hold = SurfaceHold(SurfaceHoldFlag.DEFAULT_BOUND_MS)
+        val g = RestartGuard().also { it.attach(FilePendingStore(File(dir, "a.properties")), 1L, 1L) }
+        val a = ActivityModel(hold, g, up.socket.localPort, vPort)
+        a.startSession("surface-1")
+        repeat(15) { w.au(it % 15 == 0) }
+        Thread.sleep(50)
+        assertNotNull(a.decoder)
+        val senderBefore = a.sender
+        hold.onPause()
+        Thread.sleep(200)
+        val lostAt = System.nanoTime() / 1_000_000L
+        a.surfaceDestroyed()
+        assertTrue(hold.holding)
+        assertNull(a.decoder)
+        // through the hold: the stream keeps arriving, nothing decodes
+        val auBefore = a.accessUnits.size
+        repeat(30) { w.au(false); Thread.sleep(30) }
+        assertTrue(a.accessUnits.size > auBefore)
+        assertNull(a.decoder)
+        Thread.sleep(3_000L - (System.nanoTime() / 1_000_000L - lostAt))
+        a.surfaceCreated("surface-2")
+        val backAt = System.nanoTime() / 1_000_000L
+        assertFalse(hold.holding)
+        assertTrue(a.sessionStarted)
+        assertTrue(senderBefore === a.sender)
+        // the next IDR builds the decoder on the new surface; its first frame ends the synthetic age
+        w.au(true); Thread.sleep(30)
+        assertEquals("surface-2", a.decoder?.surface)
+        hold.stallAgeMs(System.nanoTime() / 1_000_000L, a.decoder!!.rendered)
+        Thread.sleep(100)
+        val end = System.nanoTime() / 1_000_000L
+        assertEquals(listOf("start"), a.posts)                       // one session: no second start
+        assertTrue("uplink gap ${up.maxGapMs(lostAt - 200, end)}", up.maxGapMs(lostAt - 200, end) < 100L)
+        // the stall signal: stalls during the hold, then one stall_end at the picture's return
+        val kinds = synchronized(up.stalls) { up.stalls.toList() }
+        assertTrue(kinds.count { it == StallPacket.KIND_STALL } >= 20)
+        assertEquals(StallPacket.KIND_END, kinds.last())
+        assertNull(g.takePending())                                   // the guard never saw a loss
+        val row = decodeRow(hold.query())
+        assertTrue(row, row.contains("\"outcome\":\"held\""))
+        val away = Regex("\"away_ms\":(\\d+)").find(row)!!.groupValues[1].toLong()
+        assertTrue("away $away", away in 2_900L..3_300L)
+        assertTrue(row, row.contains("\"bound_ms\":12000"))
+        assertTrue(row, Regex("\"paused_before_ms\":(\\d+)").find(row)!!.groupValues[1].toLong() >= 150L)
+        assertTrue(row, Regex("\"first_frame_ms\":(\\d+)").find(row)!!.groupValues[1].toLong() in 0L..(end - backAt))
+        assertEquals("", hold.query())
+        val f = hold.reportFields()
+        assertEquals(1L, f["losses"]); assertEquals(1L, f["held"]); assertEquals(0L, f["restarted"])
+        assertEquals(2L, f["decoders_built"]); assertEquals(15L, f["rendered_before_reattach"])
+        a.stopLocalPipeline(); w.close(); up.close()
+    }
+
+    // --- the 15-s loss: today's restart --------------------------------------------------------------------------------
+
+    @Test
+    fun aFifteenSecondLossIsTodaysRestart() {
+        val clock = longArrayOf(100_000L)
+        val up = Uplink()
+        val vPort = freePort()
+        val w = Wire(vPort)
+        val hold = SurfaceHold(SurfaceHoldFlag.DEFAULT_BOUND_MS) { clock[0] }
+        val g = RestartGuard { clock[0] }.also { it.attach(FilePendingStore(File(dir, "b.properties")), 1L, 1L) }
+        val a = ActivityModel(hold, g, up.socket.localPort, vPort)
+        a.startSession("surface-1")
+        repeat(3) { w.au(it == 0) }
+        a.surfaceDestroyed()
+        clock[0] += 11_900L
+        a.expiry()
+        assertTrue(hold.holding)                                       // not yet
+        clock[0] += 100L
+        a.expiry()                                                     // the bound: today's surface-loss path
+        assertFalse(hold.holding)
+        assertFalse(a.sessionStarted)
+        assertNull(a.sender)
+        clock[0] += 3_000L
+        a.surfaceCreated("surface-2")                                  // 15 s after the loss
+        assertEquals(listOf("start", "start&guard_end=1"), a.posts)
+        assertEquals("surface", g.lastCause!!["trigger"])
+        val row = decodeRow(hold.query())
+        assertTrue(row, row.contains("\"outcome\":\"restarted\""))
+        assertTrue(row, row.contains("\"away_ms\":12000"))
+        assertEquals(1L, hold.reportFields()["restarted"])
+        a.stopLocalPipeline(); w.close(); up.close()
+    }
+
+    // --- absent = today -----------------------------------------------------------------------------------------------
+
+    @Test
+    fun absentAThreeSecondLossIsTodaysRestart() {
+        val up = Uplink()
+        val vPort = freePort()
+        val w = Wire(vPort)
+        val clock = longArrayOf(5_000L)
+        val g = RestartGuard { clock[0] }.also { it.attach(FilePendingStore(File(dir, "c.properties")), 1L, 1L) }
+        val a = ActivityModel(null, g, up.socket.localPort, vPort)
+        a.startSession("surface-1")
+        val lostAt = System.nanoTime() / 1_000_000L
+        a.surfaceDestroyed()
+        assertNull(a.sender)                                           // today: the sender stops with the surface
+        Thread.sleep(300)
+        clock[0] += 3_000L
+        a.surfaceCreated("surface-2")
+        assertEquals(listOf("start", "start&guard_end=1"), a.posts)
+        assertEquals(3_000L, g.lastCause!!["away_ms"])
+        assertTrue(up.maxGapMs(lostAt, lostAt + 290) > 250L)
+        a.stopLocalPipeline(); w.close(); up.close()
+    }
+
+    // --- the keys --------------------------------------------------------------------------------------------------
+
+    @Test
+    fun aPadSystemKeyIsConsumedTheRemotesIsNot() {
+        val clock = longArrayOf(1_000L)
+        val h = SurfaceHold(12_000L) { clock[0] }
+        val pad = SurfaceHold.SOURCE_GAMEPAD or SurfaceHold.SOURCE_JOYSTICK
+        val remote = SurfaceHold.SOURCE_KEYBOARD or SurfaceHold.SOURCE_DPAD
+        assertTrue(h.onKey(SurfaceHold.KEYCODE_BUTTON_MODE, true, pad))
+        assertTrue(h.onKey(SurfaceHold.KEYCODE_BUTTON_MODE, false, pad))
+        assertFalse(h.onKey(SurfaceHold.KEYCODE_BUTTON_MODE, true, remote))
+        assertFalse(h.onKey(SurfaceHold.KEYCODE_HOME, true, remote))
+        assertFalse(h.onKey(96 /* BUTTON_A */, true, pad))
+        assertFalse(h.onKey(4 /* BACK */, true, pad))
+        assertEquals(1L, h.reportFields()["pad_system_keys_consumed"])
+        assertEquals(2L, h.reportFields()["system_keys_passed"])
+        clock[0] += 500L
+        h.onSurfaceLost(20L, true)
+        clock[0] += 1_000L
+        assertTrue(h.onSurfaceBack())
+        h.stallAgeMs(clock[0], 1L)
+        val row = decodeRow(h.query())
+        assertTrue(row, row.contains("\"reason\":\"pad_system_key\""))
+        assertTrue(row, row.contains("\"keys\":[\"110:pad:c\",\"110:remote:p\",\"3:remote:p\",\"96:pad:p\",\"4:pad:p\"]"))
+    }
+
+    @Test
+    fun theReasonOrder() {
+        val clock = longArrayOf(1_000L)
+        fun loss(setup: (SurfaceHold) -> Unit, interactive: Boolean? = true): String {
+            val h = SurfaceHold(12_000L) { clock[0] }
+            setup(h)
+            clock[0] += 300L
+            h.onSurfaceLost(0L, interactive)
+            clock[0] += 50_000L
+            h.onExpired()
+            return Regex("\"reason\":\"(\\w+)\"").find(decodeRow(h.query()))!!.groupValues[1]
+        }
+        assertEquals("remote_system_key", loss({ it.onKey(SurfaceHold.KEYCODE_SETTINGS, true, SurfaceHold.SOURCE_DPAD) }))
+        assertEquals("user_leave", loss({ it.onUserLeave(); it.onFocus(false) }))
+        assertEquals("screen_off", loss({ it.onFocus(false) }, false))
+        assertEquals("input_device", loss({ it.onDevice("removed", 0); it.onTopResumed(false) }))
+        assertEquals("top_lost", loss({ it.onTopResumed(false); it.onFocus(false) }))
+        assertEquals("focus_lost", loss({ it.onFocus(false) }))
+        assertEquals("unknown", loss({ it.onKey(96, true, SurfaceHold.SOURCE_GAMEPAD) }))
+        // a key older than the 2-s window is not the cause
+        assertEquals("unknown", loss({ it.onKey(SurfaceHold.KEYCODE_BUTTON_MODE, true, SurfaceHold.SOURCE_GAMEPAD); clock[0] += 2_500L }))
+    }
+
+    @Test
+    fun theRowIsBoundedAndHoldsNoFreeText() {
+        val clock = longArrayOf(1_000L)
+        val h = SurfaceHold(12_000L) { clock[0] }
+        repeat(10) {
+            repeat(12) { h.onKey(SurfaceHold.KEYCODE_MENU, true, SurfaceHold.SOURCE_DPAD) }
+            repeat(6) { h.onDevice("changed", SurfaceHold.SOURCE_GAMEPAD) }
+            h.onSurfaceLost(0L, null)
+            clock[0] += 20_000L
+            h.onExpired()
+        }
+        assertEquals(8, h.pendingRows().size)
+        assertEquals(2L, h.reportFields()["rows_dropped"])
+        val row = decodeRow(h.query())
+        assertTrue(row, row.startsWith("{\"seq\":3,"))
+        assertTrue(row.length <= SurfaceHold.MAX_ROW_CHARS)
+        assertEquals(8, Regex("\"82:remote:p\"").findAll(row).count())
+        assertEquals(4, Regex("\"changed:pad:\\d+\"").findAll(row).count())
+        assertTrue(row, row.contains("\"interactive\":null"))
+        assertEquals("{\"a\":\"xy\",\"b\":[1,true]}", h.encode(linkedMapOf("a" to "x\"y", "b" to listOf(1, true))))
+    }
+
+    @Test
+    fun theSenderNeutralizeKeepsItRunning() {
+        val up = Uplink()
+        val s = NativeControllerSender("127.0.0.1", up.socket.localPort)
+        s.start()
+        Thread.sleep(100)
+        val at = System.nanoTime() / 1_000_000L
+        s.neutralize()
+        Thread.sleep(200)
+        val n0 = s.snapshot().packetsSent
+        Thread.sleep(100)
+        assertTrue(s.snapshot().packetsSent > n0)
+        assertTrue(up.maxGapMs(at, at + 290) < 100L)
+        assertEquals(0, s.snapshot().lx)
+        s.stop(); up.close()
+    }
+}
diff --git a/PrivyHub/app/src/test/java/vod/VodRetryTest.kt b/PrivyHub/app/src/test/java/vod/VodRetryTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..e5677695c4e6849c511e750ff8e027a81b620335
--- /dev/null
+++ b/PrivyHub/app/src/test/java/vod/VodRetryTest.kt
@@ -0,0 +1,223 @@
+package com.safeiot.privyhub.vod
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * B35: the movie player's retry on a fake clock, scheduler, player and server. The fake server serves a movie at
+ * a fixed byte rate and drops the connection at a byte position (TRIP-R2 §4: ~1 h 50 min in); it comes back after a
+ * while, or never. The fake player plays from it, raises Media3's 2001 at the drop, and reconnects with a Range from
+ * the position it is asked to seek to.
+ */
+class VodRetryTest {
+
+    private class Clock { var now = 0L }
+
+    private class FakeScheduler(private val clock: Clock) : VodRetryController.Scheduler {
+        var task: Pair<Long, () -> Unit>? = null
+        override fun schedule(delayMs: Long, task: () -> Unit) { this.task = (clock.now + delayMs) to task }
+        override fun cancel() { task = null }
+
+        /** Runs the pending task when due, until [until]; each run may schedule the next. */
+        fun runUntil(until: Long) {
+            while (true) {
+                val t = task ?: break
+                if (t.first > until) break
+                clock.now = t.first
+                task = null
+                t.second()
+            }
+            if (clock.now < until) clock.now = until
+        }
+    }
+
+    /** A movie at [bytesPerMs]; the connection drops at [dropAtByte]; the server is back at [upAtMs] (or never). */
+    private class FakeServer(val bytesPerMs: Long, val dropAtByte: Long, var upAtMs: Long?) {
+        val rangeStarts = mutableListOf<Long>()
+        fun open(nowMs: Long, fromByte: Long): Boolean {
+            rangeStarts.add(fromByte)
+            val up = upAtMs
+            return up != null && nowMs >= up
+        }
+    }
+
+    private class FakeUi : VodRetryController.Ui {
+        var markShown = false
+        var marks = 0
+        var retryOffered = 0
+        override fun showMark(attempt: Int) { markShown = true; marks++ }
+        override fun hideMark() { markShown = false }
+        override fun offerRetry() { retryOffered++ }
+    }
+
+    private inner class Rig(upAtMs: Long?, private val flag: Boolean = true) {
+        val clock = Clock()
+        val scheduler = FakeScheduler(clock)
+        val ui = FakeUi()
+        val rows = mutableListOf<Map<String, Any>>()
+        val server = FakeServer(bytesPerMs = 500L, dropAtByte = 6_600_000L * 500L, upAtMs = upAtMs)
+        var positionMs = 0L
+        var ready = false
+        var todaysErrorShown = 0
+        lateinit var controller: VodRetryController
+
+        val player = object : VodRetryController.Player {
+            override fun retryAt(positionMs: Long) {
+                this@Rig.positionMs = positionMs
+                if (server.open(clock.now, positionMs * server.bytesPerMs)) {
+                    ready = true
+                    controller.onReady()
+                } else {
+                    error()          // Media3 reports the failed open as a fresh 2001
+                }
+            }
+        }
+
+        /** As MainActivity: built only with the flag and not live. */
+        val built: VodRetryController? =
+            if (VodRetryController.wanted(flag, isLive = false)) {
+                VodRetryController(VodRetryPolicy(), player, scheduler, { clock.now }, { rows.add(it) }, ui,
+                    "vod:/library/A Long Feature (2026).mkv").also { controller = it }
+            } else null
+
+        /** MainActivity's onPlayerError: today's branch runs unless the controller handled the error. */
+        fun error(code: Int = 2001, name: String = "ERROR_CODE_IO_NETWORK_CONNECTION_FAILED") {
+            ready = false
+            if (built?.onError(code, name, positionMs) == true) return
+            todaysErrorShown++
+            built?.afterTodaysError()
+        }
+
+        /** Plays from the start at 1x until the server drops the connection at its byte position. */
+        fun playToTheDrop() {
+            server.open(0L, 0L)
+            ready = true
+            val dropMs = server.dropAtByte / server.bytesPerMs
+            clock.now = dropMs
+            positionMs = dropMs
+            error()
+        }
+
+        fun events() = rows.map { it["event"] }
+    }
+
+    @Test
+    fun theFlag() {
+        assertTrue(VodRetryFlag.parse("1"))
+        assertTrue(VodRetryFlag.parse(" 1 "))
+        for (v in listOf(null, "", "0", "true", "yes", "2", "junk")) assertFalse(v.toString(), VodRetryFlag.parse(v))
+        assertFalse(VodRetryFlag.read())          // no SystemProperties on the JVM: off
+        assertTrue(VodRetryController.wanted(true, isLive = false))
+        assertFalse(VodRetryController.wanted(true, isLive = true))
+        assertFalse(VodRetryController.wanted(false, isLive = false))
+    }
+
+    @Test
+    fun theBackoffAndTheBound() {
+        val p = VodRetryPolicy()
+        assertEquals(listOf(1_000L, 2_000L, 4_000L, 8_000L, 15_000L, 15_000L, 15_000L), (1..7).map { p.delayBefore(it) })
+        assertTrue(p.boundMs >= 120_000L)
+        assertEquals(150_000L, p.boundMs)
+        assertTrue(VodRetryPolicy.isRetryable(2001))
+        assertFalse(VodRetryPolicy.isRetryable(2005))
+        assertFalse(VodRetryPolicy.isRetryable(4001))
+    }
+
+    @Test
+    fun aDropAtABytePositionResumesThereWithinTheBound() {
+        val r = Rig(upAtMs = null)
+        r.playToTheDrop()
+        val dropMs = 6_600_000L
+        val dropByte = r.server.dropAtByte
+        assertTrue(r.ui.markShown)
+        assertEquals(0, r.todaysErrorShown)
+        r.server.upAtMs = dropMs + 10_000L                    // the link heals 10 s after the drop
+        r.scheduler.runUntil(dropMs + VodRetryPolicy.BOUND_MS)
+        assertTrue(r.ready)
+        assertEquals(dropMs, r.positionMs)
+        assertEquals(dropByte, r.server.rangeStarts.last())   // the reconnect's Range starts at the drop's byte
+        assertEquals(listOf(0L, dropByte, dropByte, dropByte, dropByte), r.server.rangeStarts)
+        assertEquals(listOf("vod_error", "vod_retry", "vod_retry", "vod_retry", "vod_retry", "vod_resumed"), r.events())
+        val resumed = r.rows.last()
+        assertEquals(4, resumed["attempts"])
+        assertEquals(15_000L, resumed["elapsed_ms"])          // attempts at +1, +3, +7, +15 s
+        assertTrue((resumed["elapsed_ms"] as Long) <= VodRetryPolicy.BOUND_MS)
+        assertEquals(dropMs, resumed["position_ms"])
+        assertFalse(r.ui.markShown)
+        assertEquals(0, r.todaysErrorShown)
+        assertEquals(0, r.ui.retryOffered)
+        assertNull(r.scheduler.task)
+    }
+
+    @Test
+    fun theServerDownGivesTodaysErrorAfterTheBoundThenRetry() {
+        val r = Rig(upAtMs = null)
+        r.playToTheDrop()
+        val dropMs = r.clock.now
+        r.scheduler.runUntil(dropMs + 10 * 60_000L)
+        assertFalse(r.ready)
+        assertEquals(1, r.todaysErrorShown)                   // today's "Playback error", once
+        assertEquals(1, r.ui.retryOffered)
+        assertFalse(r.ui.markShown)
+        val gaveUp = r.rows.last()
+        assertEquals("vod_gave_up", gaveUp["event"])
+        val elapsed = gaveUp["elapsed_ms"] as Long
+        assertTrue("elapsed $elapsed", elapsed in 120_000L..VodRetryPolicy.BOUND_MS)
+        assertEquals(13, gaveUp["attempts"])                  // +1 +3 +7 +15 +30 … +150 s (the bound inclusive)
+        assertEquals(dropMs, gaveUp["position_ms"])
+        assertTrue(r.server.rangeStarts.drop(1).all { it == r.server.dropAtByte })
+        // the Retry button: the server is back now
+        r.server.upAtMs = r.clock.now
+        r.controller.manualRetry()
+        assertTrue(r.ready)
+        assertEquals(dropMs, r.positionMs)
+        assertEquals("vod_resumed", r.rows.last()["event"])
+    }
+
+    @Test
+    fun aNonRetryableErrorIsTodaysAtOnce() {
+        val r = Rig(upAtMs = null)
+        r.error(code = 2005, name = "ERROR_CODE_IO_FILE_NOT_FOUND")
+        assertEquals(1, r.todaysErrorShown)
+        assertTrue(r.rows.isEmpty())
+        assertEquals(0, r.ui.retryOffered)
+        assertNull(r.scheduler.task)
+    }
+
+    @Test
+    fun cancelDropsThePendingAttempt() {
+        val r = Rig(upAtMs = 0L)
+        r.playToTheDrop()
+        r.controller.cancel()
+        r.scheduler.runUntil(r.clock.now + 60_000L)
+        assertFalse(r.ready)
+        assertEquals(listOf("vod_error", "vod_retry"), r.events())
+        assertFalse(r.ui.markShown)
+    }
+
+    @Test
+    fun noTitleOrPathInAnyRow() {
+        val r = Rig(upAtMs = null)
+        r.playToTheDrop()
+        r.scheduler.runUntil(r.clock.now + 10 * 60_000L)
+        val text = r.rows.joinToString { it.toString() }
+        for (bad in listOf("Long", "Feature", "mkv", "library", "/")) assertFalse(bad, text.contains(bad))
+        assertTrue(r.rows.all { (it["media"] as String).matches(Regex("^[0-9a-f]{12}$")) })
+    }
+
+    @Test
+    fun absentIsToday() {
+        val r = Rig(upAtMs = 0L, flag = false)
+        assertNull(r.built)
+        r.positionMs = 6_600_000L
+        r.error()
+        assertEquals(1, r.todaysErrorShown)                   // "Playback error" at once, no retry
+        assertTrue(r.rows.isEmpty())
+        assertNull(r.scheduler.task)
+        assertEquals(0, r.ui.marks)
+        assertTrue(r.server.rangeStarts.isEmpty())
+    }
+}
