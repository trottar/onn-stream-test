+    time.sleep(0.6)
+    S["r1_commands"] = ra.log[n0:]
+    S["r1_rows"] = rows()[r0:]
+    # R2: the load done, an unseen tally (1-1) shown: recognised false, never ended
+    for tag, tok in (("r2", "unknown"), ("r3", "other"), ("r3f", "fail")):
